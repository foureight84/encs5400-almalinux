def panel_label(ifname):
    """What is silkscreened on the chassis, for the ports that have a jack.

    The API says gi0..gi7; the ENCS 5412 front panel reads GE1/0..GE1/7, which
    is also Cisco's CLI form (switch_port_info.py port_xlate maps "gi" ->
    "gi1/"). When you are standing in front of the box about to pull a cable,
    the silkscreen is the name that matters.

    Verified on a 5412 by cabling GE1/0, GE1/4 and GE1/7 with every other port
    shut - each lit gi0, gi4 and gi7. The jacks are four vertically stacked
    pairs numbered downwards (GE1/1 is below GE1/0, not beside it).

    Only the 8 LAN jacks get one. te1-4 are internal backplane serdes with no
    connector, and GE0/0, GE0/1 and MGMT on the panel are I350/I210 ports
    wired to the host CPU - they are not on this switch at all.
    """
    m = re.fullmatch(r"gi(\d+)", ifname or "")
    return f"GE1/{m.group(1)}" if m else "-"


def local_nics():
    """MAC -> host interface name, read from sysfs.

    Used to say which host NIC is on the other end of a backplane port. Read
    by MAC, never by name: interface names are not stable across Debian
    releases (bookworm -> trixie renamed plenty of them), and this must keep
    working when they change. Empty dict off-host, which is fine - the peer
    column just stays blank.
    """
    out = {}
    base = "/sys/class/net"
    try:
        names = os.listdir(base)
    except OSError:
        return out
    for n in sorted(names):
        try:
            with open(os.path.join(base, n, "address")) as f:
                mac = f.read().strip().lower()
        except OSError:
            continue
        if mac and mac != "00:00:00:00:00:00":
            out.setdefault(mac, n)
    return out


class SwitchError(Exception):
    pass


# ================================================================== client
class Switch:
    def __init__(self, ip=SW_IP, user=SW_USER, password=SW_PASS):
        self.ip, self.user, self.password = ip, user, password
        self.sid = None
        self.ctx = ssl.create_default_context()
        self.ctx.check_hostname = False
        self.ctx.verify_mode = ssl.CERT_NONE

    def login(self):
        url = (f"https://{self.ip}/System.xml?action=login"
               f"&user={self.user}&password={self.password}")
        try:
            f = urllib.request.urlopen(url, context=self.ctx, timeout=10)
        except Exception as e:
            raise SwitchError(f"cannot reach {self.ip}: {e}")
        body = f.read().decode("utf8", "replace")
        # The token arrives in the sessionID RESPONSE HEADER, not the body.
        self.sid = f.headers.get("sessionid") or f.headers.get("sessionID")
        if not self.sid:
            raise SwitchError(f"login returned no sessionid header:\n{body[:300]}")
        # switch-confd disables the web idle timeout right after login;
        # without this, long-lived sessions get dropped mid-use.
        try:
            self.post("<?xml version='1.0' encoding='utf-8'?>"
                      "<DeviceConfiguration><version>1.0</version>"
                      "<EWSServiceTable action=\"set\"><Entry>"
                      "<maxIdleTimeOut>0</maxIdleTimeOut>"
                      "</Entry></EWSServiceTable></DeviceConfiguration>")
        except SwitchError:
            pass
        return self.sid

    def logout(self):
        if not self.sid:
            return
        try:
            req = urllib.request.Request(
                f"https://{self.ip}/System.xml?action=logout",
                headers={"sessionid": self.sid})
            urllib.request.urlopen(req, context=self.ctx, timeout=5).read()
        except Exception:
            pass
        self.sid = None

    def _request(self, url, data=None, retry=True):
        if not self.sid:
            self.login()
        req = urllib.request.Request(url, headers={"sessionid": self.sid},
                                     data=data)
        try:
            body = urllib.request.urlopen(
                req, context=self.ctx, timeout=15).read().decode("utf8", "replace")
        except Exception as e:
            raise SwitchError(str(e))
        if "not authenticated" in body.lower() and retry:
            self.sid = None
            return self._request(url, data, retry=False)
        return body

    def get(self, table):
        # urllib sends {} literally. curl would eat them without -g (globbing).
        return self._request(f"https://{self.ip}/wcd?{{{table}}}")

    def post(self, xml):
        return self._request(f"https://{self.ip}/wcd?", data=xml.encode("utf8"))

    @staticmethod
    def _rows(body, tag, fields, within=None):
        try:
            root = ET.fromstring(body)
        except ET.ParseError as e:
            raise SwitchError(f"bad XML: {e}")
        # A multi-table GET returns both tables in one document, so scope the
        # search to the right one instead of iterating the whole tree.
        scope = root if within is None else root.find(f".//{within}")
        if scope is None:
            return []
        return [{f: (el.findtext(f) or "").strip() for f in fields}
                for el in scope.iter(tag)]

    def ports(self):
        return self._rows(self.get("Standard802_3List"), "Entry", PORT_FIELDS)

    @staticmethod
    def _lags(body):
        """LAG1-4 with their member ports.

        Confirmed against hardware: all four groups always exist, each with a
        PortList that is empty until ports are bound. switch_port_info.py:563
        walks LAGEntry/PortList/PortEntry exactly like this.

        Standard802_3List does also report a LAGID per port, so membership
        could be derived from the ports table alone - but only PortEntry
        carries membershipType, which is what distinguishes a member that is
        forwarding from one that is merely bound. Hence this table.
        """
        try:
            root = ET.fromstring(body)
        except ET.ParseError as e:
            raise SwitchError(f"bad XML: {e}")
        out = []
        for e in root.iter("LAGEntry"):
            members = [{"portName": (p.findtext("portName") or "").strip(),
                        "membershipType": (p.findtext("membershipType") or "").strip()}
                       for p in e.iter("PortEntry")]
            out.append({"interfaceName": (e.findtext("interfaceName") or "").strip(),
                        "members": [m for m in members if m["portName"]]})
        return out

    def port_snapshot(self):
        """Everything the Ports view needs, in ONE GET.

        switch_port_info.py:550 already combines {Standard802_3List}{LAGList};
        the wcd API takes any number of tables, so counters and the MAC table
        ride along at no extra round trip. They have to be read together
        anyway - LAG membership, "is this link actually carrying anything",
        and "what is on the other end" are only meaningful against the port
        list they were sampled with.

        Returns {"ports", "lags", "stats", "macs"}.
        """
        body = self._request(f"https://{self.ip}/wcd?"
                             f"{{Standard802_3List}}{{LAGList}}"
                             f"{{StatisticsList}}{{ForwardingTable}}")
        ports = self._rows(body, "Entry", PORT_FIELDS, within="Standard802_3List")
        if not ports:
            # Should not happen, but never lose the Ports view over a wrapper
            # element that is not shaped the way we expect.
            ports = self._rows(body, "Entry", PORT_FIELDS, within="DeviceConfiguration")
        stats = {r["interfaceName"]: r
                 for r in self._rows(body, "InterfaceStatisticsEntry", STAT_FIELDS)}
        macs = self._rows(body, "Entry", MAC_FIELDS, within="ForwardingTable")
        return {"ports": ports, "lags": self._lags(body),
                "stats": stats, "macs": macs}

    def poe(self):
        return self._rows(self.get("PoEPSEInterfaceList"), "Interface",
                          ["interfaceName", "adminEnable", "detectionStatus",
                           "powerClassification", "outputPower", "powerLimit"])

    def vlans(self):
        return self._rows(self.get("VLANInterfaceMembershipTable"), "Entry",
                          ["VLANID", "VLANName", "taggedPorts", "untaggedPorts"])

    def vlan_interfaces(self):
        """Per-port VLAN config - which VLANs a port carries and how."""
        return self._rows(self.get("VLANInterfaceISList"), "Entry",
                          VLANIF_FIELDS)

    def set_vlan_interface(self, ifname, mode, pvid, tagged, untagged):
        """Restore one port's VLAN configuration.

        Same shape switch-confd used for switchport mode / PVID / tagged /
        untagged (xml_post_giga_swport_mode_str and friends), collapsed into
        one Entry so a port lands in a consistent state in a single write.
        """
        body = f"<interfaceName>{ifname}</interfaceName>"
        if mode:
            body += f"<switchportModeAdmin>{mode}</switchportModeAdmin>"
        if pvid:
            body += f"<generalPVID>{pvid}</generalPVID>"
        if tagged:
            body += f"<generalTaggedVLANs>{tagged}</generalTaggedVLANs>"
        if untagged:
            body += f"<generalUntaggedVLANs>{untagged}</generalUntaggedVLANs>"
        return self.post(
            "<?xml version='1.0' encoding='utf-8'?>\n"
            "<DeviceConfiguration>\n    <version>1.0</version>\n"
            '    <VLANInterfaceISList action="set">\n'
            f"        <Entry>{body}</Entry>\n"
            "    </VLANInterfaceISList>\n</DeviceConfiguration>")

    def macs(self):
        return self._rows(self.get("ForwardingTable"), "Entry",
                          ["VLANID", "MACAddress", "interfaceName", "addressType"])

    def stats(self):
        return self._rows(self.get("StatisticsList"), "InterfaceStatisticsEntry",
                          ["interfaceName", "receivePacketByteCount",
                           "receiveUnicastPacketCount", "transmitPacketByteCount",
                           "transmitUnicastPacketCount", "packetErrorCount"])

    # ---- writes -------------------------------------------------------
    def set_port_admin(self, ifname, up):
        return self.post(
            "<?xml version='1.0' encoding='utf-8'?>\n"
            "<DeviceConfiguration>\n    <version>1.0</version>\n"
            '    <Standard802_3List action="set">\n'
            f"        <Entry><interfaceName>{ifname}</interfaceName>"
            f"<adminState>{'1' if up else '2'}</adminState></Entry>\n"
            "    </Standard802_3List>\n</DeviceConfiguration>")

    def set_poe(self, ifname, on):
        return self.post(
            "<?xml version='1.0' encoding='utf-8'?>\n"
            "<DeviceConfiguration>\n    <version>1.0</version>\n"
            '    <PoEPSEInterfaceList action="set">\n'
            f"        <Interface><interfaceName>{ifname}</interfaceName>"
            f"<adminEnable>{'1' if on else '2'}</adminEnable></Interface>\n"
            "    </PoEPSEInterfaceList>\n</DeviceConfiguration>")

    # LAG membership is a property of the MEMBER PORT, not of the LAG: the
    # write targets the port's own Standard802_3List entry and names the group
    # in LAGID. Verbatim from switch-confd's xml_post_channel_group_str
    # (switch_interfaces.py:1035, driven by SET_IFACE_CHANNEL_GROUP).
    #
    # Unbinding is LAGID 0 with mode 0, which is what confd sends for
    # "no channel-group" (switch_interfaces.py:7061).
    def set_channel_group(self, ifname, lag_id, mode):
        return self.post(
            "<?xml version='1.0' encoding='utf-8'?>\n"
            "<DeviceConfiguration>\n    <version>1.0</version>\n"
            '    <Standard802_3List action="set">\n'
            f"        <Entry><interfaceName>{ifname}</interfaceName>"
            f"<LACPEnabled>{mode}</LACPEnabled>"
            f"<LAGID>{lag_id}</LAGID></Entry>\n"
            "    </Standard802_3List>\n</DeviceConfiguration>")

    def vlan(self, vid, create=True):
        return self.post(
            "<?xml version='1.0' encoding='utf-8'?>\n"
            "<DeviceConfiguration>\n    <version>1.0</version>\n"
            f'    <VLANList action="{"set" if create else "delete"}">\n'
            f"        <VLAN><VLANID>{vid}</VLANID></VLAN>\n"
            "    </VLANList>\n</DeviceConfiguration>")


def ok(body):
    return "<statusString>OK</statusString>" in body


# ============================================================ config files
def save_config(sw, path=CFG_DIR):
    os.makedirs(path, exist_ok=True)
    written = []

    allports = sw.port_snapshot()["ports"]
    ports = [p for p in allports if p["interfaceName"].startswith("gi")]
    ent = "".join(f"        <Entry><interfaceName>{p['interfaceName']}</interfaceName>"
                  f"<adminState>{p['adminState']}</adminState></Entry>\n"
                  for p in ports)
    f = os.path.join(path, "10-ports.xml")
    open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                       "<DeviceConfiguration>\n    <version>1.0</version>\n"
                       '    <Standard802_3List action="set">\n' + ent +
                       "    </Standard802_3List>\n</DeviceConfiguration>\n")
    written.append(f)

    # LAG membership, before VLANs so the groups exist when VLAN membership
    # is replayed. Written per member port, because that is what the API
    # takes. LAGList reports who is in a group but not in which mode, so the
    # mode comes from the port entry's own LACPEnabled. If a firmware ever
    # withholds it, fall back to auto/LACP: a static bundle facing a far end
    # that speaks LACP silently black-holes traffic, so auto is the safer
    # thing to guess.
    # Membership from the port's own LAGID, never from LAGList's
    # membershipType - see UI.lag_map() for why that distinction matters.
    mode_of = {p["interfaceName"]: p["LACPEnabled"] for p in allports}
    bound = []
    for p in allports:
        n, lid = p["interfaceName"], (p.get("LAGID") or "").strip()
        if n.startswith("gi") and lid.isdigit() and int(lid) > 0:
            bound.append((n, f"LAG{int(lid)}"))
    lag_ent = ""
    for pname, lagname in sorted(bound):
        lag_id = lagname.replace("LAG", "")
        if not lag_id.isdigit():
            continue
        mode = mode_of.get(pname) or CG_AUTO
        if mode not in CG_MODE:
            mode = CG_AUTO
        lag_ent += (f"        <Entry><interfaceName>{pname}</interfaceName>"
                    f"<LACPEnabled>{mode}</LACPEnabled>"
                    f"<LAGID>{lag_id}</LAGID></Entry>\n")
    if lag_ent:
        f = os.path.join(path, "15-lag.xml")
        open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                           "<DeviceConfiguration>\n    <version>1.0</version>\n"
                           '    <Standard802_3List action="set">\n' + lag_ent +
                           "    </Standard802_3List>\n</DeviceConfiguration>\n")
        written.append(f)

    # Skip system VLANs: 1 is default, 2363 is the management VLAN the
    # firmware recreates on every bootstrap.
    vl = [v for v in sw.vlans() if v["VLANID"] not in ("1", "2363")]
    if vl:
        ent = "".join(f"        <VLAN><VLANID>{v['VLANID']}</VLANID></VLAN>\n"
                      for v in vl)
        f = os.path.join(path, "20-vlans.xml")
        open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                           "<DeviceConfiguration>\n    <version>1.0</version>\n"
                           '    <VLANList action="set">\n' + ent +
                           "    </VLANList>\n</DeviceConfiguration>\n")
        written.append(f)

    # Per-port VLAN membership, AFTER 20-vlans.xml so the VLANs it references
    # already exist. Without this a replay recreates empty VLANs and every
    # port falls back to VLAN 1 - the switch comes back looking configured
    # while forwarding everything flat.
    #
    # gi and LAG only. te1-te4 are deliberately skipped: te2 carries the
    # management VLAN this tool talks over, and te1/te3/te4 are the module
    # fabric that switch-confd sets up from firmware defaults. Replaying a
    # stale copy of those would be a good way to cut your own session.
    ent = ""
    for r in sorted(sw.vlan_interfaces(), key=lambda r: r["interfaceName"]):
        n = r["interfaceName"]
        if not (n.startswith("gi") or n.startswith("LAG")):
            continue
        body = "".join(
            f"<{k}>{r[k]}</{k}>" for k in
            ("switchportModeAdmin", "generalPVID",
             "generalTaggedVLANs", "generalUntaggedVLANs") if r.get(k))
        if body:
            ent += f"        <Entry><interfaceName>{n}</interfaceName>{body}</Entry>\n"
    if ent:
        f = os.path.join(path, "25-vlan-ports.xml")
        open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                           "<DeviceConfiguration>\n    <version>1.0</version>\n"
                           '    <VLANInterfaceISList action="set">\n' + ent +
                           "    </VLANInterfaceISList>\n</DeviceConfiguration>\n")
        written.append(f)

    pe = sw.poe()
    if pe:
        ent = "".join(f"        <Interface><interfaceName>{p['interfaceName']}</interfaceName>"
                      f"<adminEnable>{p['adminEnable']}</adminEnable></Interface>\n"
                      for p in pe)
        f = os.path.join(path, "30-poe.xml")
        open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                           "<DeviceConfiguration>\n    <version>1.0</version>\n"
                           '    <PoEPSEInterfaceList action="set">\n' + ent +
                           "    </PoEPSEInterfaceList>\n</DeviceConfiguration>\n")
        written.append(f)
    return written


def apply_config(sw, path=CFG_DIR):
    if not os.path.isdir(path):
        return []
    out = []
    for fn in sorted(f for f in os.listdir(path) if f.endswith(".xml")):
        out.append((fn, ok(sw.post(open(os.path.join(path, fn)).read()))))
    return out


# =============================================================== self-update
API_LATEST = f"https://api.github.com/repos/{GITHUB_REPO}/releases/latest"

# A release may only write inside these prefixes. The manifest ships in the
# same tarball as the code, so this is not a trust boundary - it is a guard
# against a malformed manifest quietly scattering files across the host.
ALLOWED_DESTS = ("/usr/local/sbin/", "/etc/systemd/system/", "/opt/encs-host/")
BACKUP_ROOT = "/var/backups/encs-switch"


class UpdateError(Exception):
    pass


def _fetch(url, accept="application/vnd.github+json"):
    """HTTPS GET with certificate verification ON.

    Deliberately NOT the Switch context: that one turns verification off for
    the switch's self-signed cert on a link-local address, which is fine
    there and indefensible against github.com.
    """
    req = urllib.request.Request(url, headers={
        "Accept": accept, "User-Agent": f"encs-switch-tui/{VERSION}"})
    try:
        with urllib.request.urlopen(
                req, context=ssl.create_default_context(), timeout=20) as f:
            return f.read()
    except urllib.error.HTTPError as e:
        # GitHub answers 404 both for "no releases yet" - a normal state, not
        # a broken URL - and for a repo that does not exist. Same status, so
        # the message has to cover both.
        if e.code == 404 and url == API_LATEST:
            raise UpdateError(f"no published release for {GITHUB_REPO} "
                              f"(none yet, or the repo name is wrong)")
        raise UpdateError(f"{url}: HTTP {e.code} {e.reason}")
    except Exception as e:
        raise UpdateError(f"{url}: {e}")


def _vtuple(s):
    """'v0.1.10' -> (0, 1, 10), so 0.1.10 sorts above 0.1.9."""
    return tuple(int(x) for x in re.findall(r"\d+", s)) or (0,)


def check_update():
    """-> (tag, is_newer, {asset name: url}). Raises UpdateError on failure."""
    try:
        data = json.loads(_fetch(API_LATEST))
    except ValueError as e:
        raise UpdateError(f"release feed was not JSON: {e}")
    tag = (data.get("tag_name") or "").strip()
    if not tag:
        raise UpdateError("release feed carried no tag_name "
                          "(has a release been published yet?)")
    assets = {a.get("name"): a.get("browser_download_url")
              for a in data.get("assets", []) if a.get("name")}
    return tag, _vtuple(tag) > _vtuple(VERSION), assets


def _safe_extract(tf, dest):
    """Reject anything that would land outside dest, and any link member."""
    root = os.path.realpath(dest)
    for m in tf.getmembers():
        if m.issym() or m.islnk():
            raise UpdateError(f"refusing link member in archive: {m.name}")
        if not m.isfile() and not m.isdir():
            raise UpdateError(f"refusing special member in archive: {m.name}")
        target = os.path.realpath(os.path.join(root, m.name))
        if target != root and not target.startswith(root + os.sep):
            raise UpdateError(f"refusing path traversal in archive: {m.name}")
    tf.extractall(dest)


def _read_manifest(src):
    """mode<space>relpath<space>destpath per line; # comments; blanks skipped."""
    path = os.path.join(src, "MANIFEST")
    if not os.path.isfile(path):
        raise UpdateError("release tarball has no MANIFEST")
    out = []
    for lineno, raw in enumerate(open(path), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) != 3:
            raise UpdateError(f"MANIFEST line {lineno}: expected 3 fields")
        mode, rel, dest = parts
        srcfile = os.path.realpath(os.path.join(src, rel))
        if not srcfile.startswith(os.path.realpath(src) + os.sep):
            raise UpdateError(f"MANIFEST line {lineno}: source escapes archive")
        if not os.path.isfile(srcfile):
            raise UpdateError(f"MANIFEST line {lineno}: {rel} not in archive")
        if not dest.startswith(ALLOWED_DESTS):
            raise UpdateError(
                f"MANIFEST line {lineno}: {dest} is outside "
                f"{', '.join(ALLOWED_DESTS)}")
        try:
            imode = int(mode, 8)
        except ValueError:
            raise UpdateError(f"MANIFEST line {lineno}: bad mode {mode!r}")
        out.append((imode, srcfile, dest))
    if not out:
        raise UpdateError("MANIFEST is empty")
    return out


def do_update(force=False, say_=print):
    """Download the latest release and install it. Returns the tag installed."""
    if os.geteuid() != 0:
        raise UpdateError("--update needs root: it writes to "
                          + ", ".join(ALLOWED_DESTS))

    tag, newer, assets = check_update()
    if not newer and not force:
        say_(f"already up to date: {VERSION} (latest release is {tag})")
        return None
    say_(f"updating {VERSION} -> {tag}")

    tarname = next((n for n in assets if n.endswith(".tar.gz")), None)
    if not tarname:
        raise UpdateError(f"release {tag} has no .tar.gz asset")
    if "SHA256SUMS" not in assets:
        raise UpdateError(f"release {tag} has no SHA256SUMS asset")

    blob = _fetch(assets[tarname], accept="application/octet-stream")
    sums = _fetch(assets["SHA256SUMS"], accept="text/plain").decode()
    want = next((l.split()[0] for l in sums.splitlines()
                 if l.strip().endswith(tarname)), None)
    if not want:
        raise UpdateError(f"SHA256SUMS does not mention {tarname}")
    got = hashlib.sha256(blob).hexdigest()
    if got != want:
        raise UpdateError(f"checksum mismatch for {tarname}\n"
                          f"  expected {want}\n  got      {got}")
    say_(f"sha256 verified: {got[:16]}...")

    tmp = tempfile.mkdtemp(prefix="encs-update-")
    try:
        arc = os.path.join(tmp, tarname)
        open(arc, "wb").write(blob)
        src = os.path.join(tmp, "x")
        os.makedirs(src)
        with tarfile.open(arc, "r:gz") as tf:
            _safe_extract(tf, src)
        # Tarballs carry a single top-level directory; descend into it.
        kids = [d for d in os.listdir(src) if os.path.isdir(os.path.join(src, d))]
        if len(kids) == 1 and not os.path.exists(os.path.join(src, "MANIFEST")):
            src = os.path.join(src, kids[0])

        items = _read_manifest(src)

        # Refuse to install code that will not even parse - a truncated or
        # botched release should not take the tool out with it.
        for _, srcfile, dest in items:
            if not _is_python(srcfile):
                continue
            r = subprocess.run([sys.executable, "-m", "py_compile", srcfile],
                               capture_output=True)
            if r.returncode != 0:
                raise UpdateError(
                    f"{os.path.basename(dest)} in {tag} does not compile - "
                    f"refusing to install:\n{r.stderr.decode()[:400]}")

        backup = os.path.join(BACKUP_ROOT, time.strftime("%Y%m%d-%H%M%S"))
        os.makedirs(backup, exist_ok=True)
        units = False
        for imode, srcfile, dest in items:
            if os.path.exists(dest):
                shutil.copy2(dest, os.path.join(backup, os.path.basename(dest)))
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            # Write beside the target and rename: an atomic swap, so a running
            # copy of this very script is never half-replaced underneath us.
            staged = dest + ".new"
            shutil.copyfile(srcfile, staged)
            os.chmod(staged, imode)
            os.replace(staged, dest)
            units |= dest.startswith("/etc/systemd/system/")
            say_(f"  {dest}")
        say_(f"previous files saved in {backup}")
        if units:
            subprocess.run(["systemctl", "daemon-reload"], check=False)
            say_("  systemctl daemon-reload")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return tag


def _is_python(path):
    try:
        with open(path, "rb") as f:
            return f.read(2) == b"#!" and b"python" in f.readline().lower()
    except OSError:
        return False


