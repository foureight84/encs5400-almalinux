def stp_summary(x):
    on = (x.get("enabled") or "") == "1"
    mode = STP_MODE.get((x.get("STPOperationMode") or "").strip(), "?")
    head = (f"spanning tree: {'ENABLED' if on else 'DISABLED'}   mode {mode}"
            f"   bridge priority {x.get('bridgePriority', '?')}")
    if not on:
        # The whole reason this view exists. Cabling two front ports to the
        # same upstream switch with STP off builds a broadcast storm that
        # takes the management VLAN with it. On its own line: appended to
        # the header it ran past 80 columns and got truncated mid-warning.
        return [head,
                "NOTHING WILL BREAK A CABLING LOOP - press g to enable"]
    return [head,
            f"hello {x.get('helloTime', '?')}s  forward-delay "
            f"{x.get('forwardDelay', '?')}s  max-age {x.get('maxAge', '?')}s"
            f"   BPDU "
            f"{BPDU_MODE.get((x.get('BPDUHandlingMode') or '').strip(), '?')}"
            f"   loopback-guard "
            f"{ENABLED.get((x.get('loopbackGuardEnable') or '').strip(), '?')}"]


