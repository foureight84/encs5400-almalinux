    # ============================================ VLAN membership editor
    def act_vlan_ports(self):
        """Put a port in a VLAN - the thing this tool could not do before.

        Config/w already saved and replayed per-port VLAN membership and the
        setter already existed; there was simply no way to reach it, so a
        VLAN created here stayed empty until someone posted XML by hand.
        """
        r = self.cur()
        vid = r.get("VLANID") if r else None
        if not vid:
            return
        if vid == MGMT_VLAN:
            self.set_msg(f"VLAN {vid} carries THIS session - not editable "
                         f"from here", bad=True)
            return
        # The vnet view lists VLANs a VM is tagged into but the switch does
        # not have. Assigning a port to one would be accepted and forward
        # nothing, which is the confusing failure this row exists to warn
        # about in the first place.
        if r.get("VLANName") == "NO SUCH VLAN":
            self.set_msg(f"VLAN {vid} does not exist on the switch - create "
                         f"it first (VLANs view, n)", bad=True)
            return
        add = self.ask_pick(f"VLAN {vid}", {
            "a": (True, "add a port"), "r": (False, "remove a port")})
        if add is None:
            return
        n = self.ask_port("port")
        if n is None:
            return

        # The port's CURRENT membership, because every one of these writes
        # is action="set" on the whole VLAN list. Sending just this VLAN id
        # would replace the list and quietly drop the port out of every
        # other VLAN it was in.
        cur = {}
        try:
            for row in self.sw.vlan_interfaces():
                if row.get("interfaceName") == n:
                    cur = row
                    break
        except SwitchError as e:
            self.set_msg(f"cannot read {n}'s current VLANs: {e}", bad=True)
            return

        if not add:
            # Removal only touches the list the VLAN is actually in, so a
            # port in VLAN 100 tagged and VLAN 1 untagged keeps VLAN 1.
            #
            # A list that still has members is re-set; one that has just
            # become EMPTY has to be cleared through the restore path
            # instead. Setting it to an empty value is what hangs the
            # switch - see clear_vlan_interface.
            keep, clear = {}, []
            for field, kwarg in (("generalTaggedVLANs", "tagged"),
                                 ("generalUntaggedVLANs", "untagged"),
                                 ("trunkMemberVLANs", "trunk_members")):
                before = cur.get(field) or ""
                if str(vid) not in [str(v) for v in vlan_list_parse(before)]:
                    continue          # this VLAN was not in this list
                after = vlan_list_remove(before, vid)
                if after:
                    keep[kwarg] = after
                else:
                    clear.append(field)
            if not keep and not clear:
                self.set_msg(f"{n} is not in VLAN {vid}", bad=True)
                return

            def do_remove():
                body = ""
                if keep:
                    body = self.sw.set_vlan_interface(n, **keep)
                if clear:
                    body = self.sw.clear_vlan_interface(n, *clear)
                return body
            self.write(f"{n} removed from VLAN {vid}", do_remove)
            return

        mode = self.ask_pick(f"{n} switchport mode", {
            "a": ("11", "access"), "t": ("12", "trunk"),
            "g": ("10", "general")})
        if mode is None:
            return
        if mode == "11":
            # Access is genuinely exclusive - one untagged VLAN and no
            # list to merge into - so this one does replace, correctly.
            self.write(f"{n} access VLAN {vid}",
                       lambda: self.sw.set_vlan_interface(
                           n, mode=mode, access_pvid=vid))
        elif mode == "12":
            native = self.ask_pick(f"is VLAN {vid} the native (untagged) VLAN "
                                   f"on {n}", {"y": ("y", "yes"),
                                               "n": ("n", "no")})
            if native is None:
                return
            members = vlan_list_add(cur.get("trunkMemberVLANs"), vid)
            self.write(f"{n} trunk, {'native' if native == 'y' else 'tagged'}"
                       f" {vid}  (members {members})",
                       lambda: self.sw.set_vlan_interface(
                           n, mode=mode, trunk_members=members,
                           trunk_native=vid if native == "y" else None))
        else:
            tag = self.ask_pick(f"tag VLAN {vid} on {n}", {
                "t": ("tagged", "tagged"), "u": ("untagged", "untagged")})
            if tag is None:
                return
            if tag == "tagged":
                lst = vlan_list_add(cur.get("generalTaggedVLANs"), vid)
                kw = {"tagged": lst}
            else:
                lst = vlan_list_add(cur.get("generalUntaggedVLANs"), vid)
                kw = {"untagged": lst, "pvid": vid}
            self.write(f"{n} general, {tag} {vid}  (now {lst})",
                       lambda: self.sw.set_vlan_interface(n, mode=mode, **kw))

