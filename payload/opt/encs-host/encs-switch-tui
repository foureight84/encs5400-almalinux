def media_label(ifname, mediatype):
    """Human-meaningful media string.

    mediaType is a coarse 1=copper / 2=fiber enum, and the firmware calls
    anything that is not a copper PHY "fiber". The te ports are internal
    10GBASE-KR backplane serdes - traces on the board, no optics and no cable -
    so reporting them as fiber is actively misleading. LAGs have no media at
    all. (The same coarseness is why lspci calls the RJ45 I350 ports "Fiber".)
    """
    if ifname.startswith("te"):
        return "backplane"
    if ifname.startswith("LAG"):
        return "-"
    return MEDIA.get(mediatype, "-")
