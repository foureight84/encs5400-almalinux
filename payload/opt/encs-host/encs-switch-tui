# ==================================================================== UI
# The views with a hotkey and a tab. Deliberately still seven: these are what
# you need to get a switch forwarding, and they are the ones worth a
# single keystroke. Everything else is a menu entry - see GROUPS.
VIEWS = [("ports", "p"), ("vlans", "v"), ("poe", "e"),
         ("mac", "m"), ("stats", "s"), ("config", "c"), ("help", "?")]

# The rest, reached with TAB. A tab strip cannot hold twenty entries at 80
# columns, and hotkeys for all of them would collide with the per-view action
# keys (a is already "apply", n "new", d "delete", g "LAG", w "write"), so
# the menu is the only place these are named.
GROUPS = [
    ("Host", [
        ("vnet", "VM networks - which front jack a VM's traffic comes out of"),
    ]),
    ("Switching", [
        ("stp", "spanning tree - the loop protection this box boots without"),
        ("storm", "storm control - rate-limit broadcast/multicast floods"),
        ("mirror", "port mirroring (SPAN) - copy traffic to an analyser"),
        ("staticmac", "static MAC entries and the aging timer"),
        ("lldp", "LLDP and CDP - advertise this switch to neighbours"),
        ("lacp", "LACP tuning - system priority, port priority, timeout"),
        ("pvlan", "private VLANs - primary/isolated/community"),
    ]),
    ("Policy", [
        ("acl", "access lists and the ports they are bound to"),
        ("qos", "QoS - trust mode, CoS mapping, policers"),
        ("dot1x", "802.1X port authentication"),
        ("radius", "RADIUS servers"),
    ]),
    ("Routing and multicast", [
        ("igmp", "IGMP/MLD snooping"),
        ("l3", "ARP, static routes and the default gateway"),
    ]),
]
MENU_VIEWS = [n for _, items in GROUPS for n, _ in items]

C_OK, C_BAD, C_HDR, C_WARN, C_DIM = 1, 2, 3, 4, 5


class UI:
    def __init__(self, stdscr, sw):
        self.s, self.sw = stdscr, sw
        self.view = "ports"
        self.sel = 0
        self.top = 0
        self.msg = ""
        self.msg_bad = False
        self.detail = True
        self.help_scroll = 0
        self.data = {}
        self.last_refresh = 0
        self.connected = True
        self.update_tag = None
        # Detail panels that need the view's side tables, not just the row.
        self.details = {k: f(self) for k, f in DETAIL_FACTORIES.items()}
        self._check_update_bg()
        curses.curs_set(0)
        self.s.timeout(1000)
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(C_OK, curses.COLOR_GREEN, -1)
            curses.init_pair(C_BAD, curses.COLOR_RED, -1)
            curses.init_pair(C_HDR, curses.COLOR_CYAN, -1)
            curses.init_pair(C_WARN, curses.COLOR_YELLOW, -1)
            curses.init_pair(C_DIM, curses.COLOR_BLUE, -1)

    def _check_update_bg(self):
        """One-shot release check at startup, off the UI thread.

        Failures are swallowed on purpose. A host with no route to github.com
        is an entirely normal deployment - this VLAN is link-local and plenty
        of these boxes are isolated - and it must not produce an error banner.
        Set ENCS_NO_UPDATE_CHECK=1 to skip the request altogether.
        """
        if os.environ.get("ENCS_NO_UPDATE_CHECK"):
            return

        def run():
            try:
                tag, newer, _ = check_update()
                if newer:
                    self.update_tag = tag
            except Exception:
                pass

        threading.Thread(target=run, daemon=True).start()

    # ---------------------------------------------------------- data
    def refresh_data(self, force=False):
        try:
            if self.view == "ports":
                snap = self.sw.port_snapshot()
                self.data["ports"] = snap["ports"]
                self.data["lags"] = snap["lags"]
                self.data["portstats"] = snap["stats"]
                self.data["portmacs"] = snap["macs"]
            elif self.view == "poe":
                self.data["poe"] = self.sw.poe()
            elif self.view == "vlans":
                self.data["vlans"] = self.sw.vlans()
            elif self.view == "mac":
                self.data["mac"] = self.sw.macs()
            elif self.view == "stats":
                self.data["stats"] = self.sw.stats()
            elif self.view in SPECS:
                self.data[self.view] = SPECS[self.view]["fetch"](self.sw)
            self.connected = True
            self.last_refresh = time.time()
        except SwitchError as e:
            self.connected = False
            self.set_msg(f"{e}", bad=True)

    def rows(self):
        d = self.data.get(self.view, [])
        # Spec views store {"rows", "extra"}; the tabbed views store a list.
        return d.get("rows", []) if isinstance(d, dict) else d

    def extra(self):
        """A spec view's global settings, which are not part of any row."""
        d = self.data.get(self.view, {})
        return d.get("extra", {}) if isinstance(d, dict) else {}

    def lag_map(self):
        """member port name -> (LAG name, membershipType or "").

        Membership comes from the port's own LAGID, which is the stored
        CONFIGURATION and is unambiguous: 0 unbound, N bound to LAGN,
        regardless of admin or link state.

        It deliberately does NOT come from LAGList's membershipType. That is
        an OPERATIONAL signal and varies with mode - measured on hardware, a
        bound-but-down port reads 3 ("not candidate") under auto/LACP but 2
        ("inactive") under on/static. Treating 3 as "not a member" made a
        freshly bound port look unbound and silently dropped it from the
        saved config, which on a switch whose ports boot SHUT is the normal
        case, not an edge case.
        """
        state = {m["portName"]: m["membershipType"]
                 for lag in self.data.get("lags", []) for m in lag["members"]}
        out = {}
        for p in self.data.get("ports", []):
            n = p["interfaceName"]
            lid = (p.get("LAGID") or "").strip()
            if not n.startswith("LAG") and lid.isdigit() and int(lid) > 0:
                out[n] = (f"LAG{int(lid)}", state.get(n, ""))
        return out

    def peer_map(self):
        """switch port -> name of the host NIC on the other end of it.

        Derived, never hardcoded: cross-references the switch's own MAC table
        against this machine's NICs. That is what makes it correct on any
        chassis - MACs differ per unit, so a baked-in table would be wrong
        everywhere but here.

        A port only appears once the far end has actually sent a frame. An
        admin-down NIC never does, so a silent backplane link stays blank -
        which is itself the useful signal.
        """
        nics = local_nics()
        out = {}
        for m in self.data.get("portmacs", []):
            nic = nics.get(m["MACAddress"].strip().lower())
            if nic and m["interfaceName"]:
                out.setdefault(m["interfaceName"], nic)
        return out

    def mgmt_port(self):
        """The switch port this session's traffic actually arrives on.

        Derived, not assumed: a local NIC's MAC learned in the management
        VLAN. Shutting this port ends the session, and with no flash on the
        ASIC the only way back is a cold power cycle that wipes everything.

        Fetches the MAC table if it is not already loaded. Only the Ports
        view populates portmacs, so without this the guards that call it
        from other views - notably "do not mirror the port you are managing
        over" - silently never fired unless you happened to visit Ports
        first. A safety check that quietly does nothing is worse than none.
        """
        if self.data.get("portmacs") is None:
            self.data["portmacs"] = _try(self.sw.macs)
        nics = local_nics()
        for m in self.data.get("portmacs", []):
            if (m["VLANID"] == MGMT_VLAN
                    and m["MACAddress"].strip().lower() in nics):
                return m["interfaceName"]
        return None

    def rx_idle(self, ifname):
        """True if the link is up but has never received a unicast frame.

        The trap this exists for: a 10GBASE-KR backplane link stays trained
        even when the host NIC at the far end is administratively down, so the
        switch reports it UP while nothing whatsoever is arriving. "up" is a
        statement about the serdes, not about traffic.
        """
        s = self.data.get("portstats", {}).get(ifname)
        if not s:
            return False
        return (s.get("receiveUnicastPacketCount") or "0").strip() in ("0", "")

    def set_msg(self, m, bad=False):
        self.msg, self.msg_bad = m, bad

    # ---------------------------------------------------------- chrome
    def draw(self):
        self.s.erase()
        h, w = self.s.getmaxyx()

        state = "connected" if self.connected else "UNREACHABLE"
        # No "updated Ns ago": the views that need it auto-refresh anyway, so
        # the age was noise. That space now carries the update notice instead.
        note = (f"   UPDATE {self.update_tag} AVAILABLE - Config view, u"
                if self.update_tag else "")
        title = f" ENCS 5412 switch  {self.sw.ip}  [{state}]{note} "
        attr = curses.A_REVERSE | (0 if self.connected
                                   else curses.color_pair(C_BAD))
        self.s.addnstr(0, 0, title.ljust(w - 1), w - 1, attr)
        ver = f" v{VERSION} "
        if len(title) + len(ver) < w:
            self.s.addnstr(0, w - 1 - len(ver), ver, len(ver), attr)

        # Draw the tabs one at a time so the active one can carry its own
        # attribute - a single addnstr can only paint the whole strip.
        x = 1
        tabs = list(VIEWS)
        # A menu view is not in the strip, so show it as an extra tab while
        # it is open - otherwise nothing on screen says where you are.
        if self.view in SPECS:
            tabs = tabs + [(self.view, "TAB")]
        for n, k in tabs:
            active = n == self.view
            label = f" [{k}] {n.upper()} " if active else f" [{k}] {n} "
            if x >= w - 1:
                break
            self.s.addnstr(1, x, label, w - 1 - x,
                           curses.A_REVERSE | curses.A_BOLD if active
                           else curses.color_pair(C_HDR))
            x += len(label)
        if self.view not in SPECS and x < w - 12:
            self.s.addnstr(1, x, " [TAB] more ", w - 1 - x, curses.A_DIM)
        self.s.hline(2, 0, curses.ACS_HLINE, w)

        if self.view == "help":
            self.draw_help(3, h, w)
        elif self.view == "menu":
            self.d_menu(3, h - 3, w)
        else:
            # Ports needs the most room: LAG state and the idle-link warning
            # can each add two lines of their own.
            detailed = self.view in ("ports", "poe", "vlans") or \
                self.view in SPECS
            dh = ((9 if self.view == "ports" else 6)
                  if (self.detail and detailed) else 0)
            drawer = {"ports": self.d_ports, "poe": self.d_poe,
                      "vlans": self.d_vlans, "mac": self.d_mac,
                      "stats": self.d_stats,
                      "config": self.d_config}.get(self.view, self.d_spec)
            drawer(3, h - dh - 3, w)
            if dh:
                self.draw_detail(h - dh - 3, h, w)

        common = "   r refresh   i detail   TAB more   ? help   q quit"
        keys = {
            "ports": ("SPACE up/shut   g LAG   ENTER settings   z counters"
                      + common),
            "poe": "SPACE PoE on/off   ENTER power limit" + common,
            "vlans": ("n new   d delete   ENTER add a port   N rename"
                      + common),
            "config": ("w write config   a apply config   u check update   "
                       "TAB more   ? help   q quit"),
            "stats": "z zero the counters on this port" + common,
            "mac": "f forget learned MACs" + common,
            "help": "arrows scroll   any other key returns",
            "menu": "ENTER open   ESC back   q quit",
        }.get(self.view)
        if keys is None:
            keys = (SPECS[self.view]["keys"] + common
                    if self.view in SPECS else "r refresh   ? help   q quit")
        self.s.hline(h - 3, 0, curses.ACS_HLINE, w)
        self.s.addnstr(h - 2, 1, keys, w - 2, curses.A_DIM)
        if self.msg:
            self.s.addnstr(h - 1, 1, self.msg[:w - 2], w - 2,
                           curses.color_pair(C_BAD if self.msg_bad else C_WARN))
        self.s.refresh()

    def draw_help(self, y, h, w):
        lines = []
        for title, body in MANUAL:
            lines.append(("H", title))
            for para in body.format(ip=self.sw.ip, cfg=CFG_DIR,
                                    ver=VERSION).split("\n"):
                for wrapped in (textwrap.wrap(para, w - 6) or [""]):
                    lines.append(("T", wrapped))
            lines.append(("T", ""))
        maxs = max(0, len(lines) - (h - y - 4))
        self.help_scroll = max(0, min(self.help_scroll, maxs))
        for i, (kind, text) in enumerate(lines[self.help_scroll:]):
            if y + i >= h - 4:
                break
            if kind == "H":
                self.s.addnstr(y + i, 2, text, w - 3,
                               curses.A_BOLD | curses.color_pair(C_HDR))
            else:
                self.s.addnstr(y + i, 4, text, w - 5)
        if maxs:
            pct = int(100 * self.help_scroll / maxs)
            self.s.addnstr(h - 4, w - 12, f"-- {pct:3d}% --", 11, curses.A_DIM)

    def draw_detail(self, y, h, w):
        self.s.hline(y, 0, curses.ACS_HLINE, w)
        rows = self.rows()
        if not rows or self.sel >= len(rows):
            return
        r = rows[self.sel]
        out = []
        if self.view in SPECS:
            out = self.d_spec_detail(r)
        elif self.view == "ports":
            n = r["interfaceName"]
            role = PORT_ROLE.get(n[:2], "")
            pl = panel_label(n)
            head = f"{n}  -  {role}"
            if pl != "-":
                head = f"{n}  =  front panel {pl}  -  {role}"
            peer = self.peer_map().get(n)
            if peer:
                head += f"  ->  this host's {peer}"
            st = self.data.get("portstats", {}).get(n, {})
            out = [head,
                   f"  link {LINK.get(r['linkState'],'?')}   "
                   f"admin {ADMIN.get(r['adminState'],'?')}   "
                   f"{r['speedOper']} Mb/s {DUPLEX.get(r['duplexOperMode'],'-')}   "
                   f"media {media_label(n, r['mediaType'])}",
                   f"  mac  {r['MACAddress']}"
                   + (f"   rx {st.get('receiveUnicastPacketCount','?')} pkts"
                      f"   tx {st.get('transmitUnicastPacketCount','?')} pkts"
                      if st else "")]
            if r["linkState"] == "1" and self.rx_idle(n):
                # "Idle" means no UNICAST, which is not the same as no
                # traffic. Measured on hardware 2026-08-12: a PoE access
                # point sent 4255 bytes of LLDP/CDP and the switch learned
                # no MAC from it, because reserved multicast is neither
                # learned nor forwarded. Saying "nothing has arrived" there
                # is simply false, and sends you looking for a dead cable.
                if (st.get("receivePacketByteCount") or "0").strip() not in ("", "0"):
                    out.append("  UP BUT NO UNICAST - frames are arriving, but "
                               "only broadcast/multicast (LLDP, CDP,")
                    out.append("  DHCP and the like). Nothing is holding a "
                               "conversation through this port yet.")
                else:
                    out.append("  UP BUT IDLE - nothing at all has arrived. A "
                               "backplane link stays trained even")
                    out.append("  when the NIC at the far end is down, so UP "
                               "here means the serdes, not traffic.")
            lm = self.lag_map()
            if n.startswith("LAG"):
                mem = [(p, s) for p, (g, s) in sorted(lm.items()) if g == n]
                if mem:
                    out.append("  members: " + ", ".join(
                        f"{p} ({LAG_MEMBER.get(s, s)})" for p, s in mem))
                else:
                    out.append("  no members - select a gi port and press g "
                               "to add one.")
            elif n in lm:
                gname, st = lm[n]
                mode = CG_MODE.get(r.get("LACPEnabled", ""), "unknown mode")
                out.append(f"  bundled into {gname} ({mode})"
                           + (f" - {LAG_MEMBER[st]}" if st in LAG_MEMBER else "")
                           + ".  g rebinds or removes it.")
                if st == "2":
                    out.append("  inactive: in the group but not forwarding. "
                               "Usually the far end is not bundling this port.")
                elif st == "3":
                    out.append("  not candidate: configured, but cannot join "
                               "yet - a shut or link-down port")
                    out.append("  cannot run LACP. It is still saved and will "
                               "be replayed.")
            if r["adminState"] == "2":
                out.append("  DISABLED - you have not enabled this port, so "
                           "it will not pass traffic. SPACE enables it.")
            elif r["linkState"] != "1" and not n.startswith("LAG"):
                out.append("  enabled but no link - nothing plugged in, "
                           "or the far end is down.")
        elif self.view == "poe":
            try:
                ow, lim = int(r["outputPower"]) / 1000, int(r["powerLimit"]) / 1000
            except ValueError:
                ow, lim = 0, 0
            out = [f"{r['interfaceName']}  PoE {POE_ADMIN.get(r['adminEnable'],'?')}",
                   f"  status {POE_DETECT.get(r['detectionStatus'],'?')}   "
                   f"class {r['powerClassification']}   "
                   f"drawing {ow:.1f} W of {lim:.1f} W limit"]
            if r["adminEnable"] == "2":
                out.append("  PoE disabled on this port. SPACE enables it.")
        elif self.view == "vlans":
            out = [f"VLAN {r['VLANID']}  {r['VLANName'] or '(no name)'}",
                   f"  untagged: {r['untaggedPorts'] or '(none)'}",
                   f"  tagged  : {r['taggedPorts'] or '(none)'}"]
            if r["VLANID"] == "2363":
                out.append("  management VLAN - carries this session. Do not remove.")
            elif r["VLANID"] == "1":
                out.append("  default VLAN - all ports are untagged members.")
        for i, t in enumerate(out):
            if y + 1 + i >= h - 3:
                break
            self.s.addnstr(y + 1 + i, 2, t, w - 3,
                           curses.A_BOLD if i == 0 else curses.A_DIM)

    # ---------------------------------------------------------- views
    def _list(self, y, h, w, header, fmt, rows, colour=None):
        self.s.addnstr(y, 2, header, w - 3, curses.A_BOLD | curses.A_UNDERLINE)
        avail = h - y - 1
        if self.sel < self.top:
            self.top = self.sel
        elif self.sel >= self.top + avail:
            self.top = self.sel - avail + 1
        for i, r in enumerate(rows[self.top:self.top + avail]):
            idx = self.top + i
            attr = curses.A_REVERSE if idx == self.sel else 0
            if colour:
                attr |= colour(r)
            self.s.addnstr(y + 1 + i, 2, fmt(r), w - 3, attr)
        if len(rows) > avail:
            self.s.addnstr(y, w - 14, f"{self.sel+1}/{len(rows)}", 12, curses.A_DIM)

    def d_ports(self, y, h, w):
        lm = self.lag_map()
        pm = self.peer_map()

        def lag_col(r):
            n = r["interfaceName"]
            if n.startswith("LAG"):
                # For the group itself, show how many ports it has.
                c = sum(1 for v in lm.values() if v[0] == n)
                return f"{c} ports" if c else "-"
            g = lm.get(n)
            if not g:
                return "-"
            # Bound either way; the suffix is operational state.
            #   (i) inactive      - in the group, not forwarding
            #   (x) not candidate - cannot participate yet, e.g. LACP mode
            #                       on a port that is shut or has no link
            return g[0] + {"1": "", "2": "(i)", "3": "(x)"}.get(g[1], "")

        def link_col(r):
            s = LINK.get(r["linkState"], "?")
            # "idle" reads as what it is: trained, but nothing coming in.
            if r["linkState"] == "1" and self.rx_idle(r["interfaceName"]):
                return "UP idle"
            return s

        self._list(
            y, h, w,
            f"{'port':7}{'panel':7}{'link':9}{'admin':7}{'speed':8}{'media':10}"
            f"{'lag':9}{'attached to':16}mac",
            lambda r: (f"{r['interfaceName']:7}"
                       f"{panel_label(r['interfaceName']):7}"
                       f"{link_col(r):9}{ADMIN.get(r['adminState'],'?'):7}"
                       f"{r['speedOper']:8}"
                       f"{media_label(r['interfaceName'], r['mediaType']):10}"
                       f"{lag_col(r):9}"
                       f"{pm.get(r['interfaceName'], '-'):16}"
                       f"{r['MACAddress']}"),
            self.rows(),
            # Green only when the link is up AND something is arriving on it.
            # Yellow for trained-but-silent, which used to look identical to a
            # working port and is exactly how te1 gets mistaken for in-use.
            lambda r: (curses.color_pair(C_WARN)
                       if r["linkState"] == "1" and self.rx_idle(r["interfaceName"])
                       else curses.color_pair(C_OK) if r["linkState"] == "1"
                       else curses.color_pair(C_BAD) if r["adminState"] == "2"
                       else 0))

    def d_poe(self, y, h, w):
        def f(r):
            try:
                ow, lim = int(r["outputPower"]) / 1000, int(r["powerLimit"]) / 1000
            except ValueError:
                ow = lim = 0.0
            return (f"{r['interfaceName']:8}{POE_ADMIN.get(r['adminEnable'],'?'):7}"
                    f"{POE_DETECT.get(r['detectionStatus'],'?'):13}"
                    f"{r['powerClassification']:7}{ow:>7.1f} W {lim:>7.1f} W")
        self._list(y, h, w,
                   f"{'port':8}{'poe':7}{'status':13}{'class':7}{'draw':>9}{'limit':>10}",
                   f, self.rows(),
                   lambda r: curses.color_pair(C_OK) if r["adminEnable"] == "1" else 0)

    def d_vlans(self, y, h, w):
        self._list(y, h, w,
                   f"{'vlan':8}{'name':14}{'untagged':30}tagged",
                   lambda r: (f"{r['VLANID']:8}{(r['VLANName'] or '-'):14}"
                              f"{(r['untaggedPorts'] or '-'):30}"
                              f"{r['taggedPorts'] or '-'}"),
                   self.rows())

    def d_mac(self, y, h, w):
        self._list(y, h, w, f"{'vlan':8}{'mac':20}{'port':9}type",
                   lambda r: (f"{r['VLANID']:8}{r['MACAddress']:20}"
                              f"{r['interfaceName']:9}"
                              f"{ADDR_TYPE.get(r['addressType'], r['addressType'])}"),
                   self.rows())

    def d_stats(self, y, h, w):
        self._list(y, h, w,
                   f"{'port':8}{'rx bytes':>15}{'rx pkts':>12}"
                   f"{'tx bytes':>15}{'tx pkts':>12}{'errs':>8}",
                   lambda r: (f"{r['interfaceName']:8}"
                              f"{r['receivePacketByteCount']:>15}"
                              f"{r['receiveUnicastPacketCount']:>12}"
                              f"{r['transmitPacketByteCount']:>15}"
                              f"{r['transmitUnicastPacketCount']:>12}"
                              f"{r['packetErrorCount']:>8}"),
                   self.rows(),
                   lambda r: curses.color_pair(C_BAD)
                   if r["packetErrorCount"] not in ("0", "") else 0)

