    def d_menu(self, y, h, w):
        """The catalogue of everything that is not a tab.

        Rendered as a flat selectable list with group headings interleaved,
        so ENTER on a row opens it - the same movement keys as every other
        view rather than a second set to learn.
        """
        rows = self.menu_rows()
        self.s.addnstr(y, 2, "MORE VIEWS - ENTER opens, ESC returns",
                       w - 3, curses.A_BOLD | curses.A_UNDERLINE)
        top = y + 2
        avail = max(1, h - top - 1)
        # The list is three groups and thirteen entries, which does not fit
        # a 24-row terminal - and an entry drawn past the bottom edge is one
        # nobody can find. Scroll to keep the selection on screen.
        if self.sel < self.top:
            self.top = self.sel
        elif self.sel >= self.top + avail:
            self.top = self.sel - avail + 1
        self.top = max(0, min(self.top, max(0, len(rows) - avail)))
        for i, (kind, name, desc) in enumerate(rows[self.top:self.top + avail]):
            line = top + i
            if kind == "H":
                self.s.addnstr(line, 2, name, w - 3,
                               curses.A_BOLD | curses.color_pair(C_HDR))
            else:
                attr = curses.A_REVERSE if self.top + i == self.sel else 0
                self.s.addnstr(line, 4, f"{name:12}{desc}", w - 5, attr)
        if len(rows) > avail:
            self.s.addnstr(y, w - 14, f"{self.sel + 1}/{len(rows)}", 12,
                           curses.A_DIM)

    def menu_rows(self):
        """Group headings and entries in one list, so selection can skip
        the headings without a second index to keep in step."""
        out = []
        for title, items in GROUPS:
            out.append(("H", title, ""))
            for name, desc in items:
                out.append(("V", name, desc))
        return out

    # ------------------------------------------------- generic table views
    # Everything below the seven tabs is rendered from a SPEC rather than a
    # bespoke method. The tabbed views keep their own drawing code: they
    # carry behaviour worked out against hardware (idle-link colouring, the
    # peer map, LAG state suffixes) that is not worth generalising and would
    # be easy to regress.
    def spec(self):
        return SPECS.get(self.view, {})

    def d_spec(self, y, h, w):
        sp = self.spec()
        extra = self.extra()
        # A summary block for the table's global settings, which are a
        # different shape from its rows and would not fit as columns.
        summary = sp.get("summary")
        if summary:
            for line in summary(extra):
                if y >= h - 1:
                    return
                self.s.addnstr(y, 2, line, w - 3, curses.color_pair(C_HDR))
                y += 1
            y += 1
        cols = sp["cols"]
        header = "".join(f"{head:{width}}" if width else head
                         for head, width, _ in cols)

        def fmt(r):
            out = ""
            for _, width, fn in cols:
                try:
                    v = fn(r)
                except Exception:
                    # A firmware that omits a field must not blank the view.
                    v = "?"
                out += f"{v:{width}}" if width else str(v)
            return out

        rows = self.rows()
        if not rows:
            self.s.addnstr(y, 2, header, w - 3,
                           curses.A_BOLD | curses.A_UNDERLINE)
            self.s.addnstr(y + 2, 4, sp.get("empty", "nothing configured"),
                           w - 5, curses.A_DIM)
            return
        self._list(y, h, w, header, fmt, rows, sp.get("colour"))

    def d_spec_detail(self, r):
        """Detail lines for a spec view.

        Falls back to dumping every element the switch returned for the
        selected row. For tables nobody has run against this firmware that
        is the difference between seeing a field and not knowing it exists.
        """
        if self.view in self.details:
            return self.details[self.view](r)
        sp = self.spec()
        if sp.get("detail"):
            return sp["detail"](r)
        skip = {"interfaceName"}
        head = r.get("interfaceName") or r.get("VLANID") or ""
        body = "  " + "  ".join(f"{k}={v}" for k, v in sorted(r.items())
                                if k not in skip and v != "")
        return [str(head), body]

    # ---------------------------------------------------------- input
    def prompt(self, question, maxlen=12):
        """Read a line at the bottom of the screen. Blocking; ESC cancels.

        The screen carries a 1s timeout so the views can auto-refresh. That
        timeout also applied to getstr(), so the old prompt gave up after a
        second and vanished if you did not start typing immediately. Block
        for real here and restore the poll timeout on the way out.

        Returns the text, or None if cancelled.
        """
        h, w = self.s.getmaxyx()
        buf = ""
        curses.curs_set(1)
        self.s.timeout(-1)
        try:
            while True:
                self.s.move(h - 1, 0)
                self.s.clrtoeol()
                self.s.addnstr(h - 1, 1, question, w - 2,
                               curses.color_pair(C_WARN))
                x = min(len(question) + 2, w - 2)
                self.s.addnstr(h - 1, x, buf, max(0, w - 1 - x))
                self.s.refresh()
                c = self.s.getch()
                if c == 27:                                   # ESC
                    return None
                if c in (curses.KEY_ENTER, 10, 13):
                    return buf.strip()
                if c in (curses.KEY_BACKSPACE, 127, 8):
                    buf = buf[:-1]
                elif 32 <= c < 127 and len(buf) < maxlen:
                    buf += chr(c)
        finally:
            curses.curs_set(0)
            self.s.timeout(1000)

    # ------------------------------------------------------ prompt helpers
    # Every write below is "ask, validate, post, report". These keep that
    # loop in one place so a new setting is a line of spec rather than
    # twenty lines of prompt handling, and so cancelling always behaves the
    # same way.
    def ask_int(self, question, lo, hi, allow_blank=False):
        """An integer in [lo, hi]. None means the user cancelled or the
        answer was rejected - either way the caller should do nothing."""
        v = self.prompt(f"{question} ({lo}-{hi}), ESC cancels:")
        if v is None or (v == "" and not allow_blank):
            self.set_msg("cancelled")
            return None
        if v == "":
            return ""
        if not v.lstrip("-").isdigit() or not lo <= int(v) <= hi:
            self.set_msg(f"'{v}' is not a number in {lo}-{hi}", bad=True)
            return None
        return v

    def ask_pick(self, question, options):
        """Pick one of a small set. options is {typed: (value, label)}.

        Shows the choices in the prompt rather than expecting them to be
        remembered - this tool is used rarely and from a manual.
        """
        shown = "  ".join(f"({k}){lbl}" for k, (_, lbl) in options.items())
        v = self.prompt(f"{question}: {shown}, ESC cancels:", maxlen=16)
        if v is None or v == "":
            self.set_msg("cancelled")
            return None
        hit = options.get(v[:1].lower())
        if hit is None:
            self.set_msg(f"'{v}' is not one of {'/'.join(options)}", bad=True)
            return None
        return hit[0]

    def ask_onoff(self, question):
        return self.ask_pick(question, {"y": ("1", "on"), "n": ("2", "off")})

    def ask_text(self, question, maxlen=32):
        v = self.prompt(f"{question}, ESC cancels:", maxlen=maxlen)
        if v is None or v == "":
            self.set_msg("cancelled")
            return None
        return v

    def ask_vlan(self, question="VLAN id"):
        return self.ask_int(question, 1, 4094)

    def ask_port(self, question="port", allow_te=False):
        """A port name, checked against the ports the switch actually has.

        Typed rather than picked because these prompts are reached from
        views that are not listing ports, and an unchecked name produces a
        write the switch accepts and silently ignores.
        """
        v = self.prompt(f"{question} (e.g. gi0), ESC cancels:", maxlen=8)
        if v is None or v == "":
            self.set_msg("cancelled")
            return None
        v = v.strip()
        if not re.fullmatch(r"(gi[0-7]|te[1-4]|LAG[1-4])", v):
            self.set_msg(f"'{v}' is not a port on this switch "
                         f"(gi0-gi7, te1-te4, LAG1-LAG4)", bad=True)
            return None
        if v.startswith("te") and not allow_te:
            self.set_msg(f"{v} is an internal backplane port - not here",
                         bad=True)
            return None
        return v

    def confirm(self, question):
        return self.prompt(f"{question} type yes:") == "yes"

    def may_shut(self, ifname):
        """Guard the internal backplane ports against being shut.

        These are real, settable ports - the switch owns its end of each
        backplane link, so shutting te2 drops the management VLAN and this
        session with it, and the ASIC has no flash to recover from. Enabling
        is always allowed; only shutting is refused.
        """
        if not ifname.startswith("te") or ALLOW_TE_SHUT:
            return True
        why = TE_ROLE.get(ifname, "an internal backplane link")
        if ifname == self.mgmt_port():
            self.set_msg(f"REFUSED: {ifname} carries THIS session - {why}. "
                         f"Only a cold power cycle would undo it.", bad=True)
        else:
            self.set_msg(f"REFUSED: {ifname} is {why} - no front-panel jack. "
                         f"Override with ENCS_ALLOW_TE_SHUT=1.", bad=True)
        return False

    def bind_lag(self, p):
        """Add the selected port to a LAG, or take it out of one."""
        name = p["interfaceName"]
        if not name.startswith("gi"):
            self.set_msg(
                "only the gi front ports can join a LAG - te1/te2 are the "
                "backplane links carrying this session", bad=True)
            return
        cur = self.lag_map().get(name)
        v = self.prompt(
            f"{name} is in {cur[0]} - enter LAG 1-{MAX_LAG}, 0 removes it, "
            f"ESC cancels:" if cur
            else f"add {name} to which LAG? 1-{MAX_LAG}, 0 = none, "
                 f"ESC cancels:")
        if v is None or v == "":
            self.set_msg("cancelled")
            return
        if not v.isdigit() or not 0 <= int(v) <= MAX_LAG:
            self.set_msg(f"'{v}' is not a LAG number (0-{MAX_LAG})", bad=True)
            return
        lag_id = int(v)
        if lag_id == 0:
            if not cur:
                self.set_msg(f"{name} is not in a LAG", bad=True)
                return
            self.write(f"{name} leaves {cur[0]}",
                       lambda: self.sw.set_channel_group(name, 0, 0))
            return
        m = self.prompt(f"{name} -> LAG{lag_id} mode: (a)uto = LACP, "
                        f"(o)n = static, ESC cancels:")
        if m is None or m == "":
            self.set_msg("cancelled")
            return
        mode = {"a": CG_AUTO, "o": CG_ON}.get(m[:1].lower())
        if mode is None:
            self.set_msg(f"'{m}' is not a mode - answer a or o", bad=True)
            return
        self.write(f"{name} -> LAG{lag_id} ({CG_MODE[mode]})",
                   lambda: self.sw.set_channel_group(name, lag_id, mode))

    def write(self, label, fn):
        try:
            r = fn()
            good = ok(r)
            self.set_msg(f"{label}: {'OK' if good else 'FAILED'}", bad=not good)
            self.refresh_data()
        except SwitchError as e:
            self.set_msg(f"{label}: {e}", bad=True)

    def cur(self):
        """The selected row, or None if the view is empty."""
        rows = self.rows()
        return rows[self.sel] if rows and self.sel < len(rows) else None

    def suspend(self, fn):
        """Hand the terminal back, run fn, then take it again.

        For the host-side actions, which print a unified diff of what they
        are about to do to /etc/network/interfaces. Squeezing that into a
        curses panel would mean either truncating it or reimplementing a
        pager, and a diff you cannot read in full is worse than no diff -
        this is the one change in the tool that can cost the management VLAN.
        """
        curses.def_prog_mode()
        curses.endwin()
        try:
            fn()
            try:
                input("\n  press ENTER to return to the TUI ")
            except (EOFError, KeyboardInterrupt):
                pass
        finally:
            curses.reset_prog_mode()
            self.s.redrawwin()
            self.s.refresh()

    # ======================================================= VM networks
    def _vnet(self):
        vn = load_vnet()
        if vn is None:
            self.set_msg("encs-switch-vnet is not installed - re-run "
                         "install.sh from the host bundle", bad=True)
        return vn

    @staticmethod
    def _vnet_args(**kw):
        """A stand-in for the argparse namespace those commands expect."""
        return type("args", (), kw)()

    def act_vnet_create(self):
        """Create the bridge that puts VM traffic on the front jacks.

        Two-step on purpose, and both steps happen outside curses: the tool
        prints the exact diff first and writes nothing until the confirmation
        that follows it.
        """
        vn = self._vnet()
        if not vn:
            return
        if self.extra().get("bridge_up"):
            self.set_msg(f"{vn.BRIDGE} already exists", bad=True)
            return

        def go():
            print(f"\n  {vn.BRIDGE} is the Proxmox equivalent of NFVIS's "
                  f"lan-br: one VLAN-aware\n  bridge on the backplane NIC. "
                  f"VMs on it reach the GE1/x jacks instead of\n  sharing the "
                  f"MGMT CPU port with this hypervisor.\n")
            try:
                vn.cmd_init(self._vnet_args(yes=False, reload=False))
                if input("\n  write this config? type yes: ").strip() == "yes":
                    vn.cmd_init(self._vnet_args(yes=True, reload=False))
                else:
                    print("  nothing written")
            except SystemExit as e:
                if e.code and not isinstance(e.code, int):
                    print(f"  {e.code}")
        self.suspend(go)
        self.set_msg("nothing is live until 'ifreload -a' runs from a shell")
        self.refresh_data()

    def act_vnet_teardown(self):
        """Give the backplane NIC back: VMs return to vmbr0.

        Deliberately does NOT touch the switch. Front-port VLANs stay as they
        are and keep replaying from /etc/encs-switch - this is a statement
        about where VM traffic goes on this host, not about how the switch is
        configured.
        """
        vn = self._vnet()
        if not vn:
            return
        if not self.extra().get("managed"):
            self.set_msg(f"{vn.BRIDGE} was not created by this tool - "
                         f"nothing to remove", bad=True)
            return

        def go():
            try:
                vn.cmd_teardown(self._vnet_args(yes=False, force=False))
                if input("\n  apply this? type yes: ").strip() == "yes":
                    vn.cmd_teardown(self._vnet_args(yes=True, force=False))
                else:
                    print("  nothing written")
            except SystemExit as e:
                if e.code and not isinstance(e.code, int):
                    print(f"  {e.code}")
        self.suspend(go)
        self.set_msg("nothing is live until 'ifreload -a' runs from a shell")
        self.refresh_data()

    # ==================================================== spanning tree
    def act_stp_global(self):
        what = self.ask_pick("spanning tree", {
            "e": ("enable", "on/off"), "m": ("mode", "mode"),
            "p": ("prio", "bridge priority"), "t": ("timers", "timers"),
            "b": ("bpdu", "BPDU handling"), "l": ("loop", "loopback guard"),
            "c": ("cost", "path cost style")})
        if what is None:
            return
        if what == "enable":
            v = self.ask_onoff("spanning tree")
            if v:
                on = v == STP_ON
                self.write(f"spanning tree {'enabled' if on else 'disabled'}",
                           lambda: self.sw.set_stp_enabled(on))
                # Turning STP on is the whole point of this view, but it is
                # not free: ports go through listening and learning before
                # they forward, so a link that worked a moment ago goes
                # quiet for ~30s. Say so, or it looks like a fault. This
                # has to come AFTER the write, which sets its own message.
                if on and not self.msg_bad:
                    self.set_msg("spanning tree enabled - ports will hold "
                                 "down for ~30s while they converge")
        elif what == "mode":
            v = self.ask_pick("mode", {"s": ("0", "STP"), "r": ("2", "RSTP"),
                                       "m": ("3", "MSTP")})
            if v:
                self.write(f"STP mode {STP_MODE[v]}",
                           lambda: self.sw.set_stp_mode(v))
        elif what == "prio":
            # 802.1D allows 0-61440 but only in steps of 4096; the switch
            # rejects anything else, so round rather than pass it through.
            v = self.ask_int("bridge priority, multiples of 4096", 0, 61440)
            if v:
                p = str((int(v) // 4096) * 4096)
                self.write(f"bridge priority {p}",
                           lambda: self.sw.set_stp_bridge({"bridgePriority": p}))
        elif what == "timers":
            hello = self.ask_int("hello time (s)", 1, 10)
            if hello is None:
                return
            fwd = self.ask_int("forward delay (s)", 4, 30)
            if fwd is None:
                return
            age = self.ask_int("max age (s)", 6, 40)
            if age is None:
                return
            # 802.1D requires 2*(fwd-1) >= age >= 2*(hello+1). The switch
            # enforces it too, but rejects the whole write with a bare
            # FAILED, which is not a useful thing to stare at.
            if 2 * (int(fwd) - 1) < int(age):
                self.set_msg(f"invalid: 2*(forward_delay-1) must be >= max_age "
                             f"({2 * (int(fwd) - 1)} < {age})", bad=True)
                return
            if int(age) < 2 * (int(hello) + 1):
                self.set_msg(f"invalid: max_age must be >= 2*(hello+1) "
                             f"({age} < {2 * (int(hello) + 1)})", bad=True)
                return
            self.write("STP timers", lambda: self.sw.set_stp_bridge({
                "helloTime": hello, "forwardDelay": fwd, "maxAge": age}))
        elif what == "bpdu":
            v = self.ask_pick("BPDU handling", {
                "f": ("1", "filtering"), "l": ("2", "flooding")})
            if v:
                self.write(f"BPDU {BPDU_MODE[v]}",
                           lambda: self.sw.set_stp_setting(
                               {"BPDUHandlingMode": v}))
        elif what == "loop":
            v = self.ask_onoff("loopback guard")
            if v:
                self.write(f"loopback guard {ENABLED[v]}",
                           lambda: self.sw.set_stp_setting(
                               {"loopbackGuardEnable": v}))
        elif what == "cost":
            v = self.ask_pick("path cost style", {
                "s": ("1", "short"), "l": ("2", "long")})
            if v:
                self.write(f"path cost {PATHCOST_TYPE[v]}",
                           lambda: self.sw.set_stp_setting(
                               {"pathCostDefaultValueType": v}))

