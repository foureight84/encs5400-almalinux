    # ---- 802.1X and RADIUS -----------------------------------------------
    # The global on/off element is <enabled>, NOT <systemAuthControl> as
    # the ConfD-side naming suggests. Confirmed by reading the table off a
    # live 5412 (2026-08-11): it returns enabled, failureTraps, guestVlanID,
    # guestVlanTimeout, radiusAuthenticationMethod, successTraps and
    # nothing else. Writing systemAuthControl was accepted and silently
    # ignored, which is the worst kind of wrong.
    def dot1x_global(self):
        return self.read_one("Standard_802_1xGlobalSetting")

    def dot1x_ports(self):
        return self.read("Standard_802_1xInterfaceList")

    def set_dot1x_global(self, values):
        return self.post(doc("Standard_802_1xGlobalSetting", fields(values)))

    def set_dot1x_port(self, ifname, values):
        values = dict(values)
        values["interfaceName"] = ifname
        return self.post(entry_doc("Standard_802_1xInterfaceList", values))

    def radius_servers(self):
        return self.read("RadiusServerList", tag="RadiusServer")

    def radius_defaults(self):
        return self.read_one("RadiusDefaultParam")

    def set_radius_default(self, values):
        return self.post(doc("RadiusDefaultParam", fields(values)))

    def set_radius_server(self, host, values=None, create=True):
        values = dict(values or {})
        values["IPAddress"] = host
        return self.post(entry_doc("RadiusServerList", values,
                                   action="set" if create else "delete",
                                   tag="RadiusServer"))

    # ---- IGMP / MLD snooping ---------------------------------------------
    # Snooping is IGMPSnoopEnbl and the querier is querierEnbl - not
    # IGMPSnoopingEnbl / IGMPQuerierEnbl. Read off a live 5412 2026-08-11;
    # the table also carries MLDSnoopEnbl, MLDQuerierEnbl, the proxy flags
    # and the entry counters, which this does not currently expose.
    def multicast_global(self):
        return self.read_one("MulticastGlobalSetting")

    def igmp_vlans(self):
        return self.read("IGMPMLDSnoopVLANList")

    def igmp_router_ports(self):
        return self.read("IGMPMLDSnoopRouterPortList")

    def igmp_groups(self):
        return self.read("IGMPMLDSnoopGroupList")

    def set_multicast_global(self, values):
        return self.post(doc("MulticastGlobalSetting", fields(values)))

    def set_igmp_vlan(self, vid, values):
        values = dict(values)
        values["VLANID"] = vid
        return self.post(entry_doc("IGMPMLDSnoopVLANList", values))

    def set_igmp_router_ports(self, vid, portlist, static=True):
        key = "staticPortList" if static else "forbiddenPortList"
        return self.post(entry_doc("IGMPMLDSnoopRouterPortList",
                                   {"VLANID": vid, key: portlist}))

    # ---- L3 --------------------------------------------------------------
    def arp_entries(self):
        return self.read("ARPList", tag="ARPEntry")

    def arp_global(self):
        return self.read_one("ARPGlobalSetting")

    def ipv4_global(self):
        return self.read_one("IPv4GlobalSetting")

    def ipv4_interfaces(self):
        return self.read("IPv4InterfaceList")

    def routes(self):
        return self.read("IPv4RouteList")

    def gateways(self):
        return self.read("IPv4GatewayList", tag="GWEntry")

    def set_arp_timeout(self, seconds):
        return self.post(doc("ARPGlobalSetting", fields({"timeout": seconds})))

    def set_arp(self, ifname, ip, mac, create=True):
        """A static ARP entry. The MAC element is physicalAddress here, not
        MACAddress as everywhere else in this API."""
        return self.post(entry_doc("ARPList", {
            "interfaceName": ifname, "IPAddress": ip, "physicalAddress": mac},
            action="set" if create else "delete", tag="ARPEntry"))

    def set_ip_routing(self, on):
        return self.post(doc("IPv4GlobalSetting",
                             fields({"unicastRoutingEnable":
                                     "1" if on else "2"})))

    def set_route(self, prefix, prefix_len, nexthop, metric=None,
                  route_type=ROUTE_REMOTE, create=True):
        """A static route. Note the prefix LENGTH, not a dotted netmask."""
        return self.post(entry_doc("IPv4RouteList", {
            "destinationIPv4Address": prefix,
            "destinationPrefixLength": prefix_len,
            "nextHopIPv4Address": nexthop,
            "routeType": route_type, "metric": metric},
            action="add" if create else "delete"))

    def set_gateway(self, ip, create=True):
        """Default gateway. fwdStatus/owner/replaceAction are the constants
        confd sent (xml_ipv4_gateway_str); the switch rejects the entry
        without them."""
        return self.post(entry_doc("IPv4GatewayList", {
            "IPAddr": ip, "fwdStatus": "1", "owner": "1",
            "replaceAction": "1"},
            action="set" if create else "delete", tag="GWEntry"))

    # ---- private VLANs ---------------------------------------------------
    def private_vlans(self):
        return self.read("PrivateVLANTable")

    def private_vlan_assoc(self):
        return self.read("PrivateVLANAssociationTable")

    def private_vlan_hosts(self):
        return self.read("PrivateVLANHostPortTable")

    def private_vlan_promisc(self):
        return self.read("PrivateVLANPromiscuousPortTable")

    def set_private_vlan(self, vid, mode, create=True):
        return self.post(entry_doc(
            "PrivateVLANTable", {"VLANID": vid, "privateVLANType": mode},
            action="set" if create else "delete"))

    def set_private_vlan_assoc(self, primary, community, create=True):
        return self.post(entry_doc("PrivateVLANAssociationTable", {
            "primaryVLANID": primary, "communityVLANsList": community},
            action="set" if create else "delete"))

    def set_private_vlan_host(self, ifname, primary, secondary, create=True):
        return self.post(entry_doc("PrivateVLANHostPortTable", {
            "interfaceName": ifname, "primaryVLAN": primary,
            "secondaryVLAN": secondary},
            action="set" if create else "delete"))

    def set_private_vlan_promisc(self, ifname, primary, secondaries,
                                 create=True):
        return self.post(entry_doc("PrivateVLANPromiscuousPortTable", {
            "interfaceName": ifname, "primaryVLAN": primary,
            "secondaryVLANList": secondaries},
            action="add" if create else "delete"))


def ok(body):
    return "<statusString>OK</statusString>" in body


def _try(fn, default=None):
    """A read that is allowed to fail.

    Views and save_config both assemble several tables, and not every
    firmware build carries all of them. A missing side table should cost
    one column, not the whole view - so only a view's PRIMARY read is left
    unguarded, where a real connection failure still surfaces as
    UNREACHABLE.
    """
    try:
        return fn()
    except SwitchError:
        return [] if default is None else default


