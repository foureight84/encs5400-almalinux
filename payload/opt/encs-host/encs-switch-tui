            "VLANID": vid, "MACAddress": mac, "interfaceName": ifname,
            "addressStatus": status}))

    def del_static_mac(self, vid, mac):
        """Delete takes the key plus an EMPTY addressStatus element.

        That empty element is not decoration - it is what
        xml_mac_address_status_restore_str sends, and the switch matches the
        entry on the pair (VLANID, MACAddress).
        """
        return self.post(doc("ForwardingStaticTable", el(
            "Entry", fields({"VLANID": vid, "MACAddress": mac}, 12)
            + "\n            <addressStatus/>"), "delete"))

