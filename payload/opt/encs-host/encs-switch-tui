# =================================================================== main
def cli_status(sw):
    try:
        sw.login()
        ports = sw.ports()
    except SwitchError as e:
        print(f"UNREACHABLE: {e}")
        return 1
    gi = [p for p in ports if p["interfaceName"].startswith("gi")]
    up = sum(1 for p in gi if p["linkState"] == "1")
    shut = sum(1 for p in gi if p["adminState"] == "2")
    print(f"switch {sw.ip}: OK - {len(gi)} front ports, {up} link up, "
          f"{shut} disabled")
    if shut:
        print("  WARNING: disabled ports will not pass traffic "
              "(run the TUI, select the port, press SPACE)")
    sw.logout()
    return 0


def main():
    sw = Switch()
    arg = sys.argv[1] if len(sys.argv) > 1 else ""

    if arg in ("-h", "--help"):
        print(__doc__)
        return
    if arg in ("--version", "-V"):
        print(f"encs-switch-tui {VERSION}")
        return
    if arg in ("--check-update", "--update"):
        try:
            if arg == "--check-update":
                tag, newer, _ = check_update()
                print(f"installed {VERSION}, latest release {tag}"
                      + ("  -- run 'encs-switch-tui --update'" if newer
                         else "  -- up to date"))
                return
            if do_update(force="--force" in sys.argv):
                print("done. Restart any running encs-switch-tui.")
        except UpdateError as e:
            sys.exit(f"ERROR: {e}")
        return
    if arg == "--status":
        sys.exit(cli_status(sw))
    if arg in ("--save", "--apply"):
        try:
            sw.login()
        except SwitchError as e:
            sys.exit(f"ERROR: {e}")
        if arg == "--save":
            for f in save_config(sw):
                print(f if "(removed" in f else f"wrote {f}")
            sw.logout()
            return
        bad = False
        for f, good, why in apply_config(sw):
            print(f"{f}: {'OK' if good else 'FAILED - ' + why}")
            bad |= not good
        sw.logout()
        sys.exit(1 if bad else 0)

    try:
        sw.login()
    except SwitchError as e:
        sys.exit(
            f"ERROR: {e}\n\n"
            f"  This tool must run on the HYPERVISOR - the switch is reachable\n"
            f"  over VLAN 2363 on the X710 backplane, which the host owns.\n"
            f"  The bootstrap VM cannot reach it.\n\n"
            f"  Checks:\n"
            f"    ip -br addr show sw2363     -> expect 169.254.1.1/16\n"
            f"    ping -c2 {SW_IP}\n"
            f"    qm list                     -> is the bootstrap VM running?\n"
            f"  In the VM:  encs-switch-status\n")
    try:
        curses.wrapper(lambda scr: UI(scr, sw).run())
    finally:
        sw.logout()


if __name__ == "__main__":
    main()
