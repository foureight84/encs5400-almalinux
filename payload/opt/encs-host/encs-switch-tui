def save_config(sw, path=CFG_DIR):
    os.makedirs(path, exist_ok=True)
    # A saved RADIUS server carries its shared secret in the clear, because
    # that is how the switch reports it back. Lock the directory down on
    # every save rather than only when one happens to exist - the cost is
    # nothing and the failure mode is a leaked secret.
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass
    written = []

    allports = sw.port_snapshot()["ports"]
    ports = [p for p in allports if p["interfaceName"].startswith("gi")]
    ent = "".join(f"        <Entry><interfaceName>{p['interfaceName']}</interfaceName>"
                  f"<adminState>{p['adminState']}</adminState></Entry>\n"
                  for p in ports)
    f = os.path.join(path, "10-ports.xml")
    open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                       "<DeviceConfiguration>\n    <version>1.0</version>\n"
                       '    <Standard802_3List action="set">\n' + ent +
                       "    </Standard802_3List>\n</DeviceConfiguration>\n")
    written.append(f)

    # LAG membership, before VLANs so the groups exist when VLAN membership
    # is replayed. Written per member port, because that is what the API
    # takes. LAGList reports who is in a group but not in which mode, so the
    # mode comes from the port entry's own LACPEnabled. If a firmware ever
    # withholds it, fall back to auto/LACP: a static bundle facing a far end
    # that speaks LACP silently black-holes traffic, so auto is the safer
    # thing to guess.
    # Membership from the port's own LAGID, never from LAGList's
    # membershipType - see UI.lag_map() for why that distinction matters.
    mode_of = {p["interfaceName"]: p["LACPEnabled"] for p in allports}
    bound = []
    for p in allports:
        n, lid = p["interfaceName"], (p.get("LAGID") or "").strip()
        if n.startswith("gi") and lid.isdigit() and int(lid) > 0:
            bound.append((n, f"LAG{int(lid)}"))
    lag_ent = ""
    for pname, lagname in sorted(bound):
        lag_id = lagname.replace("LAG", "")
        if not lag_id.isdigit():
            continue
        mode = mode_of.get(pname) or CG_AUTO
        if mode not in CG_MODE:
            mode = CG_AUTO
        lag_ent += (f"        <Entry><interfaceName>{pname}</interfaceName>"
                    f"<LACPEnabled>{mode}</LACPEnabled>"
                    f"<LAGID>{lag_id}</LAGID></Entry>\n")
    if lag_ent:
        f = os.path.join(path, "15-lag.xml")
        open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                           "<DeviceConfiguration>\n    <version>1.0</version>\n"
                           '    <Standard802_3List action="set">\n' + lag_ent +
                           "    </Standard802_3List>\n</DeviceConfiguration>\n")
        written.append(f)

    # Skip system VLANs: 1 is default, 2363 is the management VLAN the
    # firmware recreates on every bootstrap.
    vl = [v for v in sw.vlans() if v["VLANID"] not in ("1", "2363")]
    if vl:
        # The name goes in too. It is part of the VLAN entry, and leaving it
        # out meant a renamed VLAN came back nameless after a power cycle -
        # the switch would look configured while every label was gone.
        ent = "".join(
            f"        <VLAN><VLANID>{v['VLANID']}</VLANID>"
            + (f"<VLANName>{xesc(v['VLANName'])}</VLANName>"
               if v.get("VLANName") else "")
            + "</VLAN>\n"
            for v in vl)
        f = os.path.join(path, "20-vlans.xml")
        open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                           "<DeviceConfiguration>\n    <version>1.0</version>\n"
                           '    <VLANList action="set">\n' + ent +
                           "    </VLANList>\n</DeviceConfiguration>\n")
        written.append(f)

    # Per-port VLAN membership, AFTER 20-vlans.xml so the VLANs it references
    # already exist. Without this a replay recreates empty VLANs and every
    # port falls back to VLAN 1 - the switch comes back looking configured
    # while forwarding everything flat.
    #
    # gi and LAG only. te1-te4 are deliberately skipped: te2 carries the
    # management VLAN this tool talks over, and te1/te3/te4 are the module
    # fabric that switch-confd sets up from firmware defaults. Replaying a
    # stale copy of those would be a good way to cut your own session.
    ent = ""
    for r in sorted(sw.vlan_interfaces(), key=lambda r: r["interfaceName"]):
        n = r["interfaceName"]
        if not (n.startswith("gi") or n.startswith("LAG")):
            continue
        body = "".join(
            f"<{k}>{r[k]}</{k}>" for k in
            ("switchportModeAdmin", "generalPVID",
             "generalTaggedVLANs", "generalUntaggedVLANs") if r.get(k))
        if body:
            ent += f"        <Entry><interfaceName>{n}</interfaceName>{body}</Entry>\n"
    if ent:
        f = os.path.join(path, "25-vlan-ports.xml")
        open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                           "<DeviceConfiguration>\n    <version>1.0</version>\n"
                           '    <VLANInterfaceISList action="set">\n' + ent +
                           "    </VLANInterfaceISList>\n</DeviceConfiguration>\n")
        written.append(f)

    pe = sw.poe()
    if pe:
        ent = "".join(f"        <Interface><interfaceName>{p['interfaceName']}</interfaceName>"
                      f"<adminEnable>{p['adminEnable']}</adminEnable></Interface>\n"
                      for p in pe)
        f = os.path.join(path, "30-poe.xml")
        open(f, "w").write("<?xml version='1.0' encoding='utf-8'?>\n"
                           "<DeviceConfiguration>\n    <version>1.0</version>\n"
                           '    <PoEPSEInterfaceList action="set">\n' + ent +
                           "    </PoEPSEInterfaceList>\n</DeviceConfiguration>\n")
        written.append(f)

    written += save_extended(sw, path, allports)
    for stale in SAVED_FILES:
        f = os.path.join(path, stale)
        if f not in written and os.path.exists(f):
            os.unlink(f)
            written.append(f"{f} (removed - no longer configured)")
    return written


# ------------------------------------------------- the rest of the config
# One file per TABLE, not per area. apply_config posts each file as a single
# request body, and a request body is one <DeviceConfiguration> around one
# table - so an area that spans three tables is three files, numbered so
# they replay in dependency order.
#
# Areas are saved only when they are actually configured. Replaying firmware
# defaults would be harmless but would turn a plain L2 switch's config
# directory into thirty files of nothing, and hide the handful that matter.
# Each predicate below says what "configured" means for that area, with the
# default it is measured against.
def entries_doc(table, rows, tag="Entry", action="set"):
    """One table, many entries - the shape most of these files take."""
    body = "\n".join(el(tag, fields(r, 12)) for r in rows)
    return doc(table, body, action) + "\n"


def _write(path, name, body, written, secret=False):
    """Write one replay file.

    secret=True means the body contains a credential the switch handed back
    in the clear. Created 0600 rather than chmod'd afterwards, so the
    secret is never briefly world-readable between the two calls.
    """
    f = os.path.join(path, name)
    if secret:
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
        fd = os.open(f, flags, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(body)
        os.chmod(f, 0o600)          # in case the file already existed
    else:
        with open(f, "w") as fh:
            fh.write(body)
    written.append(f)


def _no_backplane(rows):
    """Drop te1-te4 from anything destined for a replay file.

    te2 carries the management VLAN and te1/te3/te4 are the module fabric
    the firmware sets up itself. These files are applied UNATTENDED by
    encs-switch-replay.service after every cold power cycle, so a single te
    entry anywhere in them breaks management on every boot - not once, but
    every time the box loses power.

    25-vlan-ports.xml has excluded te ports since 0.0.4. When the other
    per-port tables were added in 0.1.0 the rule was not carried over, and
    storm control, LLDP, LACP and port settings all quietly swept the
    backplane in. Caught by the on-hardware static check 2026-08-12; hence
    one shared helper rather than the same filter written out six times.
    """
    return [r for r in rows
            if not (r.get("interfaceName") or "").startswith("te")]


def _pick(rows, keys, require="interfaceName"):
    """Keep only the fields we intend to replay, dropping blanks.

    Read-only operational fields (port state, role, whether a LAG member is
    forwarding) come back in the same Entry as the settings. Replaying them
    is at best ignored and at worst rejected, so the save is an explicit
    allowlist rather than an echo of whatever arrived.
    """
    out = []
    for r in rows:
        if require and not r.get(require):
            continue
        vals = {k: r[k] for k in keys if r.get(k) not in (None, "")}
        if not vals:
            continue
        if require:
            vals = {require: r[require], **vals}
        out.append(vals)
    return out


def save_extended(sw, path, allports=None):
    written = []

    # ---- per-port settings that are not admin state. Kept out of
    # 10-ports.xml on purpose: that file is the one thing standing between
    # a cold power cycle and a switch that forwards nothing, and it has
    # been replayed against hardware in this exact shape. Anything new goes
    # in its own file so a firmware that rejects it cannot take the port
    # enables down with it.
    #
    # gi ports ONLY. te1-te4 are the internal backplane serdes: te2 carries
    # the management VLAN this tool talks over, and writing speedAdmin or
    # autoNegotiationAdminEnabled at a 10GBASE-KR link is at best
    # meaningless and at worst renegotiates the link you are managing
    # through. 25-vlan-ports.xml has excluded te ports since 0.0.4 for
    # exactly this reason; this file must too, and did not - a replay was
    # observed to take the management VLAN down on live hardware
    # (2026-08-11). LAGs have no PHY settings either.
    #
    # This matters more than a one-off: encs-switch-replay.service applies
    # these files unattended after every cold power cycle, so a te entry
    # here would break management on every single boot.
    # No LAGs either: Standard802_3List lists LAG1-4 alongside the ports,
    # with speedAdmin 0, and the firmware answers a replay of that with
    # statusCode 3 "Invalid speedAdmin value" - which failed the whole file,
    # and with it encs-switch-replay.service, on every boot (seen on
    # hardware 2026-09-03; every gi entry in the same file was accepted).
    settings = _pick([r for r in _no_backplane(allports or [])
                      if not (r.get("interfaceName") or "").startswith("LAG")],
                     ["interfaceDescription", "speedAdmin",
                      "autoNegotiationAdminEnabled", "flowControlAdminType"])
    # Only ports that have actually been given a setting - autoneg on with
    # no description is the default and not worth a file. speedAdmin is
    # always populated (it echoes the negotiated speed), so on its own it
    # says nothing; it only means something when autoneg is off.
    settings = [s for s in settings
                if s.get("interfaceDescription")
                or s.get("autoNegotiationAdminEnabled") == "2"
                or s.get("flowControlAdminType") == "1"]
    if settings:
        _write(path, "11-port-settings.xml",
               entries_doc("Standard802_3List", settings), written)

    # ---- spanning tree. Saved only when it is running: a cold boot brings
    # the switch back with STP off, which is also the default, so an
    # untouched switch has nothing to restore.
    g = _try(sw.stp_global, {})
    if (g.get("enabled") or "") == "1":
        _write(path, "35-stp-global.xml",
               doc("SpanningTreeGlobalParam", fields({
                   "enabled": g.get("enabled"),
                   "STPOperationMode": g.get("STPOperationMode")})) + "\n",
               written)
        d = sw.stp()
        gs = d["global"]
        bridge = {k: gs[k] for k in ("forwardDelay", "helloTime", "maxAge",
                                     "bridgePriority") if gs.get(k)}
        if bridge:
            _write(path, "36-stp-bridge.xml",
                   doc("STP", el("GlobalSetting",
                                 el("BridgeSetting", fields(bridge, 16), 12),
                                 8)) + "\n", written)
        ports = _pick(_no_backplane(d["ports"]), ["STPEnabled", "pathCost", "portPriority",
                                   "portFastEnabled", "BPDUGuardEnabled",
                                   "rootGuardEnabled"])
        if ports:
            body = "\n".join(el("InterfaceEntry", fields(p, 16), 12)
                             for p in ports)
            _write(path, "37-stp-ports.xml",
                   doc("STP", el("InterfaceList", body, 8)) + "\n", written)

    # ---- storm control. Default is 0 (off) on every class.
    storm = _pick(_no_backplane(_try(sw.storm)), ["broadcastRateValue", "broadcastUnitType",
                                   "unicastRateValue", "unicastUnitType",
                                   "multicastRateValue", "multicastUnitType",
                                   "multicastType"])
    if any(r.get(k, "0") not in ("", "0")
           for r in storm for k in ("broadcastRateValue", "unicastRateValue",
                                    "multicastRateValue")):
        _write(path, "40-storm.xml", entries_doc("StormControlTable", storm),
               written)

    # ---- port mirroring. Destination first: it is what creates the
    # session, and a source naming a session that does not exist yet is
    # rejected. Both tables take action="add", not "set".
    dests = _pick(_try(sw.span_destinations),
                  ["sessionId", "ifIndex", "isReflector", "portType",
                   "remoteVlanId"], require="sessionId")
    if dests:
        _write(path, "41-span-dest.xml",
               entries_doc("SpanDestinationTable", dests, action="add"),
               written)
        srcs = _pick(_try(sw.span_sources),
                     ["sessionId", "sourceType", "sourceIdx",
                      "sourceDirection"], require="sessionId")
        if srcs:
            _write(path, "42-span-src.xml",
                   entries_doc("SpanSourceTable", srcs, action="add"), written)

    # ---- LLDP/CDP. Default is enabled, tx+rx on every port, so only save
    # when something has been turned off or retimed.
    lg = _try(sw.lldp_global, {})
    lports = _pick(_no_backplane(_try(sw.lldp_ports)), ["portState"])
    if (lg.get("LLDPEnabled") or "1") != "1" or \
            (lg.get("updateInterval") or "30") != "30":
        _write(path, "45-lldp-global.xml",
               doc("LLDPGlobalSetting", fields({
                   "LLDPEnabled": lg.get("LLDPEnabled"),
                   "updateInterval": lg.get("updateInterval")})) + "\n",
               written)
    if any(p.get("portState") != LLDP_TXRX for p in lports):
        _write(path, "46-lldp-ports.xml",
               entries_doc("LLDPInterfaceList", lports, tag="InterfaceEntry"),
               written)
    cports = _pick(_no_backplane(_try(sw.cdp_ports)), ["enbl"])
    if any(p.get("enbl") != "1" for p in cports):
        _write(path, "47-cdp-ports.xml",
               entries_doc("CDPInterfaceList", cports), written)

    # ---- LACP tuning. Defaults are system priority 1, port priority 1,
    # long timeout (1).
    ag = _try(sw.lacp_global, {})
    if (ag.get("LACPSystemPriority") or "1") != "1" or \
            (ag.get("LAGLoadBalance") or "1") != "1":
        _write(path, "50-lacp-global.xml",
               doc("LACPGlobalSetting", fields({
                   "LACPSystemPriority": ag.get("LACPSystemPriority"),
                   "LAGLoadBalance": ag.get("LAGLoadBalance")})) + "\n",
               written)
    aports = _pick(_no_backplane(_try(sw.lacp_ports)), ["actorPortPriority",
                                         "actorPortAdminTimeout"])
    if any(p.get("actorPortPriority", "1") != "1"
           or p.get("actorPortAdminTimeout", "1") != "1" for p in aports):
        _write(path, "51-lacp-ports.xml",
               entries_doc("LACPPortList", aports), written)

    # ---- MAC aging and static entries. Firmware default is 300s.
    fg = _try(sw.forwarding_global, {})
    if (fg.get("agingInterval") or "300") != "300":
        _write(path, "55-mac-aging.xml",
               doc("ForwardingGlobalSetting",
                   fields({"agingInterval": fg["agingInterval"]})) + "\n",
               written)
    static = _pick(_try(sw.static_macs),
                   ["VLANID", "MACAddress", "interfaceName", "addressStatus"],
                   require=None)
    if static:
        _write(path, "56-static-mac.xml",
               entries_doc("ForwardingStaticTable", static), written)

    # ---- ACLs. Three tables and the order matters: an ACE naming an ACL
    # that does not exist yet is rejected, and so is a binding to a missing
    # ACL. Hence 60 / 61 / 62.
    acls = _pick(_try(sw.acls), ["ACLName", "ACLType"], require="ACLName")
    if acls:
        _write(path, "60-acls.xml",
               entries_doc("ACLList", acls, tag="ACLEntry"), written)
        aces = _pick(_try(sw.aces), ["ACLName", "ruleType", "ruleAction",
                                     "rulePriority", "sourceAddressType",
                                     "sourceMACAddress", "sourceMaskBits",
                                     "destAddressType", "destMACAddress",
                                     "destMaskBits"], require="ACLName")
        if aces:
            _write(path, "61-aces.xml", entries_doc("ACEList", aces), written)
        binds = _pick(_no_backplane(_try(sw.acl_bindings)),
                      ["interfaceType", "interfaceName", "bindingType",
                       "defaultRuleAction", "ACLIPv4MACName",
                       "defaultRuleActionOut", "ACLIPv4MACNameOut"])
        if binds:
            _write(path, "62-acl-bindings.xml",
                   entries_doc("ACLBindingList", binds,
                               tag="ACLBindingEntry"), written)

    # ---- QoS. Default mode is disabled, so nothing to restore until it is
    # switched on.
    qg = _try(sw.qos_global, {})
    if (qg.get("QoSMode") or QOS_DISABLED) != QOS_DISABLED:
        _write(path, "65-qos-global.xml",
               doc("QoSSettingGlobalParam", fields({
                   "QoSMode": qg.get("QoSMode"),
                   "basicTrustMode": qg.get("basicTrustMode")})) + "\n",
               written)
        cos = _pick(_no_backplane(_try(sw.cos_settings)), ["CoS"])
        if any(c.get("CoS", "0") != "0" for c in cos):
            _write(path, "66-qos-cos.xml",
                   doc("CoSSetting", el("InterfaceList", "\n".join(
                       el("Interface", fields(c, 16), 12) for c in cos),
                       8)) + "\n", written)
        queues = _pick(_try(sw.cos_queue_map), ["CoS", "queueNumber"],
                       require=None)
        if queues:
            _write(path, "67-cos-queue.xml",
                   entries_doc("CoSToQueueMappingList", queues,
                               tag="CoSMappingEntry"), written)
    pol = _pick(_try(sw.policers),
                ["policerName", "CIR", "CBS", "PIR", "PBS", "action",
                 "markVal"], require="policerName")
    if pol:
        _write(path, "68-policers.xml",
               entries_doc("AggregatePolicerList", pol), written)

    # ---- RADIUS before 802.1X: authentication with no server to ask fails
    # every port closed, so the servers must be back first.
    #
    # NOTE the shared secret. The switch hands keyString back in plain
    # text, so it lands in this file in plain text - there is no way to
    # replay a RADIUS server without it. The file is created 0600 and the
    # config directory 0700; treat /etc/encs-switch as secret-bearing from
    # the moment a RADIUS server exists, and think before committing it.
    servers = _pick(_try(sw.radius_servers),
                    ["IPAddress", "authPortNo", "accountPortNo",
                     "serverPriority", "numberOfRetries", "timeoutForReply",
                     "deadTime", "keyString", "globalDefaultKeyEnable"],
                    require="IPAddress")
    if servers:
        _write(path, "70-radius.xml",
               entries_doc("RadiusServerList", servers, tag="RadiusServer"),
               # Unconditionally 0600, not "0600 when a keyString is
               # present". If a firmware build reports the secret under an
               # element we do not recognise, the file is still sensitive
               # and this is the cheapest way not to depend on guessing right.
               written, secret=True)
    dg = _try(sw.dot1x_global, {})
    if (dg.get("enabled") or "2") == "1":
        _write(path, "71-dot1x-global.xml",
               doc("Standard_802_1xGlobalSetting",
                   fields({"enabled": "1"})) + "\n", written)
        dports = _pick(_no_backplane(_try(sw.dot1x_ports)), ["portControl", "hostMode"])
        if dports:
            _write(path, "72-dot1x-ports.xml",
                   entries_doc("Standard_802_1xInterfaceList", dports),
                   written)

    # ---- IGMP snooping. Default is off.
    mg = _try(sw.multicast_global, {})
    if (mg.get("IGMPSnoopEnbl") or "2") == "1" or \
            (mg.get("multicastFilterEnbl") or "2") == "1":
        _write(path, "75-multicast.xml",
               doc("MulticastGlobalSetting", fields({
                   "IGMPSnoopEnbl": mg.get("IGMPSnoopEnbl"),
                   "multicastFilterEnbl": mg.get("multicastFilterEnbl")}))
               + "\n", written)
        vlans = _pick(_try(sw.igmp_vlans),
                      ["VLANID", "snoopEnbl", "querierEnbl", "immediateLeave",
                       "querierVersion"], require="VLANID")
        if vlans:
            _write(path, "76-igmp-vlans.xml",
                   entries_doc("IGMPMLDSnoopVLANList", vlans), written)
        routers = _pick(_try(sw.igmp_router_ports),
                        ["VLANID", "staticPortList", "forbiddenPortList"],
                        require="VLANID")
        if routers:
            _write(path, "77-igmp-routers.xml",
                   entries_doc("IGMPMLDSnoopRouterPortList", routers), written)

    # ---- private VLANs, primary before the associations that reference it.
    pv = _pick(_try(sw.private_vlans), ["VLANID", "privateVLANType"],
               require="VLANID")
    if pv:
        _write(path, "80-pvlan.xml", entries_doc("PrivateVLANTable", pv),
               written)
        assoc = _pick(_try(sw.private_vlan_assoc),
                      ["primaryVLANID", "communityVLANsList"],
                      require="primaryVLANID")
        if assoc:
            _write(path, "81-pvlan-assoc.xml",
                   entries_doc("PrivateVLANAssociationTable", assoc), written)
        hosts = _pick(_no_backplane(_try(sw.private_vlan_hosts)),
                      ["primaryVLAN", "secondaryVLAN"])
        if hosts:
            _write(path, "82-pvlan-hosts.xml",
                   entries_doc("PrivateVLANHostPortTable", hosts), written)
        promisc = _pick(_no_backplane(_try(sw.private_vlan_promisc)),
                        ["primaryVLAN", "secondaryVLANList"])
        if promisc:
            _write(path, "83-pvlan-promisc.xml",
                   entries_doc("PrivateVLANPromiscuousPortTable", promisc,
                               action="add"), written)

    # ---- L3. All of this is off on an L2 switch; only save what exists.
    #
    # Routes are deliberately NOT filtered to statics: routeType tells them
    # apart, and replaying a connected route would be rejected, so only
    # ROUTE_REMOTE entries are kept.
    routes = [r for r in _try(sw.routes)
              if (r.get("routeType") or "") == ROUTE_REMOTE]
    routes = _pick(routes, ["destinationIPv4Address",
                            "destinationPrefixLength", "nextHopIPv4Address",
                            "routeType", "metric"], require=None)
    gws = _pick(_try(sw.gateways), ["IPAddr", "fwdStatus", "owner"],
                require="IPAddr")
    arps = _pick(_no_backplane(_try(sw.arp_entries)),
                 ["interfaceName", "IPAddress", "physicalAddress"])
    ag2 = _try(sw.arp_global, {})
    # Routing on/off comes BEFORE the gateway and routes it governs -
    # replaying static routes onto a switch with routing still disabled
    # restores the table and none of the behaviour.
    ipg = _try(sw.ipv4_global, {})
    if (ipg.get("unicastRoutingEnable") or "2") == "1":
        _write(path, "84-ip-routing.xml",
               doc("IPv4GlobalSetting",
                   fields({"unicastRoutingEnable": "1"})) + "\n", written)
    if gws:
        _write(path, "85-gateway.xml",
               entries_doc("IPv4GatewayList", gws, tag="GWEntry"), written)
    if routes:
        _write(path, "86-routes.xml",
               entries_doc("IPv4RouteList", routes, action="add"), written)
    if arps:
        _write(path, "87-arp.xml",
               entries_doc("ARPList", arps, tag="ARPEntry"), written)
    if ag2.get("timeout") and ag2["timeout"] != "60000":
        _write(path, "88-arp-timeout.xml",
               doc("ARPGlobalSetting",
                   fields({"timeout": ag2["timeout"]})) + "\n", written)

    return written


def status_string(body):
    """The switch's own verdict: 'OK', or e.g. 'Invalid speedAdmin value'."""
    m = re.search(r"<statusString>([^<]*)</statusString>", body or "")
    return m.group(1).strip() if m else "no statusString in reply"


def apply_config(sw, path=CFG_DIR):
    """-> [(file, ok, reason)], reason being the switch's statusString."""
    if not os.path.isdir(path):
        return []
    out = []
    for fn in sorted(f for f in os.listdir(path) if f.endswith(".xml")):
        body = sw.post(open(os.path.join(path, fn)).read())
        out.append((fn, ok(body), status_string(body)))
    return out


# =============================================================== self-update
API_LATEST = f"https://api.github.com/repos/{GITHUB_REPO}/releases/latest"

# A release may only write inside these prefixes. The manifest ships in the
# same tarball as the code, so this is not a trust boundary - it is a guard
# against a malformed manifest quietly scattering files across the host.
ALLOWED_DESTS = ("/usr/local/sbin/", "/etc/systemd/system/", "/opt/encs-host/")
BACKUP_ROOT = "/var/backups/encs-switch"


class UpdateError(Exception):
    pass


def _fetch(url, accept="application/vnd.github+json"):
    """HTTPS GET with certificate verification ON.

    Deliberately NOT the Switch context: that one turns verification off for
    the switch's self-signed cert on a link-local address, which is fine
    there and indefensible against github.com.
    """
    req = urllib.request.Request(url, headers={
        "Accept": accept, "User-Agent": f"encs-switch-tui/{VERSION}"})
    try:
        with urllib.request.urlopen(
                req, context=ssl.create_default_context(), timeout=20) as f:
            return f.read()
    except urllib.error.HTTPError as e:
        # GitHub answers 404 both for "no releases yet" - a normal state, not
        # a broken URL - and for a repo that does not exist. Same status, so
        # the message has to cover both.
        if e.code == 404 and url == API_LATEST:
            raise UpdateError(f"no published release for {GITHUB_REPO} "
                              f"(none yet, or the repo name is wrong)")
        raise UpdateError(f"{url}: HTTP {e.code} {e.reason}")
    except Exception as e:
        raise UpdateError(f"{url}: {e}")


def _vtuple(s):
    """'v0.1.10' -> (0, 1, 10), so 0.1.10 sorts above 0.1.9."""
    return tuple(int(x) for x in re.findall(r"\d+", s)) or (0,)


def check_update():
    """-> (tag, is_newer, {asset name: url}). Raises UpdateError on failure."""
    try:
        data = json.loads(_fetch(API_LATEST))
    except ValueError as e:
        raise UpdateError(f"release feed was not JSON: {e}")
    tag = (data.get("tag_name") or "").strip()
    if not tag:
        raise UpdateError("release feed carried no tag_name "
                          "(has a release been published yet?)")
    assets = {a.get("name"): a.get("browser_download_url")
              for a in data.get("assets", []) if a.get("name")}
    return tag, _vtuple(tag) > _vtuple(VERSION), assets


def _safe_extract(tf, dest):
    """Reject anything that would land outside dest, and any link member."""
    root = os.path.realpath(dest)
    for m in tf.getmembers():
        if m.issym() or m.islnk():
            raise UpdateError(f"refusing link member in archive: {m.name}")
        if not m.isfile() and not m.isdir():
            raise UpdateError(f"refusing special member in archive: {m.name}")
        target = os.path.realpath(os.path.join(root, m.name))
        if target != root and not target.startswith(root + os.sep):
            raise UpdateError(f"refusing path traversal in archive: {m.name}")
    tf.extractall(dest)


def _read_manifest(src):
    """mode<space>relpath<space>destpath per line; # comments; blanks skipped."""
    path = os.path.join(src, "MANIFEST")
    if not os.path.isfile(path):
        raise UpdateError("release tarball has no MANIFEST")
    out = []
    for lineno, raw in enumerate(open(path), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) != 3:
            raise UpdateError(f"MANIFEST line {lineno}: expected 3 fields")
        mode, rel, dest = parts
        srcfile = os.path.realpath(os.path.join(src, rel))
        if not srcfile.startswith(os.path.realpath(src) + os.sep):
            raise UpdateError(f"MANIFEST line {lineno}: source escapes archive")
        if not os.path.isfile(srcfile):
            raise UpdateError(f"MANIFEST line {lineno}: {rel} not in archive")
        if not dest.startswith(ALLOWED_DESTS):
            raise UpdateError(
                f"MANIFEST line {lineno}: {dest} is outside "
                f"{', '.join(ALLOWED_DESTS)}")
        try:
            imode = int(mode, 8)
        except ValueError:
            raise UpdateError(f"MANIFEST line {lineno}: bad mode {mode!r}")
        out.append((imode, srcfile, dest))
    if not out:
        raise UpdateError("MANIFEST is empty")
    return out


def do_update(force=False, say_=print):
    """Download the latest release and install it. Returns the tag installed."""
    if os.geteuid() != 0:
        raise UpdateError("--update needs root: it writes to "
                          + ", ".join(ALLOWED_DESTS))

    tag, newer, assets = check_update()
    if not newer and not force:
        say_(f"already up to date: {VERSION} (latest release is {tag})")
        # Still worth running: the files may be current while the bootstrap
        # VM's passthrough is not (a BIOS/CIMC update between two --updates),
        # and a 0.2.1 host's --update installed 0.2.3 with the OLD code, which
        # had no post-update step - so "run --update again" has to work.
        _post_update(say_)
        return None
    say_(f"updating {VERSION} -> {tag}")

    # Releases also carry encs-builder-<ver>.tar.gz (the image build tree),
    # which is not for the host: pick the host bundle by name.
    tarname = next((n for n in assets
                    if n.startswith("encs-host-") and n.endswith(".tar.gz")), None)
    if not tarname:
        raise UpdateError(f"release {tag} has no encs-host-*.tar.gz asset")
    if "SHA256SUMS" not in assets:
        raise UpdateError(f"release {tag} has no SHA256SUMS asset")

    blob = _fetch(assets[tarname], accept="application/octet-stream")
    sums = _fetch(assets["SHA256SUMS"], accept="text/plain").decode()
    want = next((l.split()[0] for l in sums.splitlines()
                 if l.strip().endswith(tarname)), None)
    if not want:
        raise UpdateError(f"SHA256SUMS does not mention {tarname}")
    got = hashlib.sha256(blob).hexdigest()
    if got != want:
        raise UpdateError(f"checksum mismatch for {tarname}\n"
                          f"  expected {want}\n  got      {got}")
    say_(f"sha256 verified: {got[:16]}...")

    tmp = tempfile.mkdtemp(prefix="encs-update-")
    try:
        arc = os.path.join(tmp, tarname)
        open(arc, "wb").write(blob)
        src = os.path.join(tmp, "x")
        os.makedirs(src)
        with tarfile.open(arc, "r:gz") as tf:
            _safe_extract(tf, src)
        # Tarballs carry a single top-level directory; descend into it.
        kids = [d for d in os.listdir(src) if os.path.isdir(os.path.join(src, d))]
        if len(kids) == 1 and not os.path.exists(os.path.join(src, "MANIFEST")):
            src = os.path.join(src, kids[0])

        items = _read_manifest(src)

        # Refuse to install code that will not even parse - a truncated or
        # botched release should not take the tool out with it.
        for _, srcfile, dest in items:
            if not _is_python(srcfile):
                continue
            r = subprocess.run([sys.executable, "-m", "py_compile", srcfile],
                               capture_output=True)
            if r.returncode != 0:
                raise UpdateError(
                    f"{os.path.basename(dest)} in {tag} does not compile - "
                    f"refusing to install:\n{r.stderr.decode()[:400]}")

        backup = os.path.join(BACKUP_ROOT, time.strftime("%Y%m%d-%H%M%S"))
        os.makedirs(backup, exist_ok=True)
        units = False
        for imode, srcfile, dest in items:
            if os.path.exists(dest):
                shutil.copy2(dest, os.path.join(backup, os.path.basename(dest)))
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            # Write beside the target and rename: an atomic swap, so a running
            # copy of this very script is never half-replaced underneath us.
            staged = dest + ".new"
            shutil.copyfile(srcfile, staged)
            os.chmod(staged, imode)
            os.replace(staged, dest)
            units |= dest.startswith("/etc/systemd/system/")
            say_(f"  {dest}")
        say_(f"previous files saved in {backup}")
        if units:
            subprocess.run(["systemctl", "daemon-reload"], check=False)
            say_("  systemctl daemon-reload")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    _post_update(say_)
    return tag


def _post_update(say_=print):
    """Apply what the new tools would do at the next boot, now.

    encs-switch-startup.service runs `encs-switch-vnet startup --fix` before
    pve-guests, which since 0.2.3 also re-points the bootstrap VM's hostpciN
    line when a BIOS/CIMC update has moved the Marvell on the PCI bus. Someone
    running --update is quite likely doing so *because* of that - their VM
    will not start - so do not make them wait for a reboot, or learn a second
    command. Proxmox only: the ESXi bootstrap handles its own passthrough.
    Nothing here starts a VM: booting the loader against an ASIC that is
    already up wedges it, and only the operator knows which case this is.
    """
    vnet = "/usr/local/sbin/encs-switch-vnet"
    if not (os.path.isdir("/etc/pve/qemu-server") and os.path.exists(vnet)):
        return
    subprocess.run(["systemctl", "enable", "encs-switch-startup.service"],
                   capture_output=True, check=False)
    say_("post-update: checking the bootstrap VM's passthrough and boot order")
    r = subprocess.run([vnet, "hostpci", "--fix"], capture_output=True,
                       text=True, check=False)
    out = (r.stdout + r.stderr).strip()
    if out:
        for line in out.splitlines():
            say_("  " + line)
    if r.returncode == 0 and "->" in out:
        say_("  the VM now points at the Marvell's current address - "
             "start it with: qm start <vmid>")
    r = subprocess.run([vnet, "startup", "--fix", "--quiet"],
                       capture_output=True, text=True, check=False)
    for line in (r.stdout + r.stderr).strip().splitlines():
        say_("  " + line)


def _is_python(path):
    try:
        with open(path, "rb") as f:
            return f.read(2) == b"#!" and b"python" in f.readline().lower()
    except OSError:
        return False


