# ------------------------------------------------------------- VLAN lists
# generalTaggedVLANs and friends are comma-separated with ranges ("1,100-102").
# switch_interfaces.py:5310-5326 parses exactly that shape on the way in.
#
# These exist because the per-port VLAN write is action="set" on the WHOLE
# list: sending one VLAN id replaces everything the port was in. Adding a
# port to a second VLAN has to send both, or it silently leaves the first.
def vlan_list_parse(s):
    out = set()
    for part in (s or "").replace(" ", "").split(","):
        if not part:
            continue
        if "-" in part:
            a, _, b = part.partition("-")
            if a.isdigit() and b.isdigit():
                out.update(range(int(a), int(b) + 1))
        elif part.isdigit():
            out.add(int(part))
    return out


def vlan_list_format(vids):
    """Back to "1,100-102" - collapsed, because a trunk carrying 400 VLANs
    would otherwise produce a list too long for the switch to accept."""
    out, start, prev = [], None, None
    for n in sorted(vids):
        if start is None:
            start = prev = n
        elif n == prev + 1:
            prev = n
        else:
            out.append(str(start) if start == prev else f"{start}-{prev}")
            start = prev = n
    if start is not None:
        out.append(str(start) if start == prev else f"{start}-{prev}")
    return ",".join(out)


def vlan_list_add(current, vid):
    return vlan_list_format(vlan_list_parse(current) | {int(vid)})


def vlan_list_remove(current, vid):
    return vlan_list_format(vlan_list_parse(current) - {int(vid)})


def panel_label(ifname):
    """What is silkscreened on the chassis, for the ports that have a jack.

    The API says gi0..gi7; the ENCS 5412 front panel reads GE1/0..GE1/7, which
    is also Cisco's CLI form (switch_port_info.py port_xlate maps "gi" ->
    "gi1/"). When you are standing in front of the box about to pull a cable,
    the silkscreen is the name that matters.

    Verified on a 5412 by cabling GE1/0, GE1/4 and GE1/7 with every other port
    shut - each lit gi0, gi4 and gi7. The jacks are four vertically stacked
    pairs numbered downwards (GE1/1 is below GE1/0, not beside it).

    Only the 8 LAN jacks get one. te1-4 are internal backplane serdes with no
    connector, and GE0/0, GE0/1 and MGMT on the panel are I350/I210 ports
    wired to the host CPU - they are not on this switch at all.
    """
    m = re.fullmatch(r"gi(\d+)", ifname or "")
    return f"GE1/{m.group(1)}" if m else "-"


def local_nics():
    """MAC -> host interface name, read from sysfs.

    Used to say which host NIC is on the other end of a backplane port. Read
    by MAC, never by name: interface names are not stable across Debian
    releases (bookworm -> trixie renamed plenty of them), and this must keep
    working when they change. Empty dict off-host, which is fine - the peer
    column just stays blank.
    """
    out = {}
    base = "/sys/class/net"
    try:
        names = os.listdir(base)
    except OSError:
        return out
    for n in sorted(names):
        try:
            with open(os.path.join(base, n, "address")) as f:
                mac = f.read().strip().lower()
        except OSError:
            continue
        if mac and mac != "00:00:00:00:00:00":
            out.setdefault(mac, n)
    return out


class SwitchError(Exception):
    pass


# ============================================================ XML builders
# switch-confd carried one hand-written xml_*_str template per setting -
# roughly 200 of them, all the same envelope around a different element path.
# Reproducing that here would be 200 near-identical methods, so the envelope
# is built instead and only the element path is written out per call. The
# generated bytes are byte-for-byte what confd sent, modulo whitespace, which
# the switch does not care about.
def xesc(s):
    """Escape a value for XML text.

    Cisco never did this - its callers were ConfD, which had already
    validated every string. Ours come from a prompt, so an ACL named
    'a&b' or a port description with an angle bracket in it would
    otherwise produce a body the switch rejects as malformed.
    """
    return (str(s).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def el(tag, inner, indent=8):
    """<tag>inner</tag>, laid out like Cisco's templates."""
    pad = " " * indent
    if "\n" in inner:
        return f"{pad}<{tag}>\n{inner}\n{pad}</{tag}>"
    return f"{pad}<{tag}>{inner}</{tag}>"


def fields(pairs, indent=8):
    """{k: v} -> one <k>v</k> per line, skipping None AND empty strings.

    Empty strings are dropped rather than sent as <foo></foo>. That is not
    a tidiness choice - it is a hard-won one. An earlier version kept them,
    on the theory that an empty value means "clear this field". It does
    not: confd clears a field with action="restore" and a SELF-CLOSING
    <foo/> (xml_post_no_giga_tagged_vlan_str). Sending action="set" with an
    empty-text <generalTaggedVLANs></generalTaggedVLANs> instead wedged the
    switch hard enough to need a physical power cycle, twice, on
    2026-08-11 - reproducibly, at the same write both times.

    So: to clear something, use the restore path (clear_vlan_interface),
    never an empty value here.
    """
    if isinstance(pairs, dict):
        pairs = pairs.items()
    return "\n".join(f"{' ' * indent}<{k}>{xesc(v)}</{k}>"
                     for k, v in pairs if v is not None and v != "")


def doc(table, body, action="set"):
    """The DeviceConfiguration envelope every wcd write uses.

    action is "set" (creates and modifies), "delete", "add" or "restore" -
    the four verbs confd used. "restore" resets a field to its firmware
    default and takes an empty element rather than a value.
    """
    return ("<?xml version='1.0' encoding='utf-8'?>\n"
            "<DeviceConfiguration>\n    <version>1.0</version>\n"
            f'    <{table} action="{action}">\n'
            f"{body}\n"
            f"    </{table}>\n</DeviceConfiguration>")


def entry_doc(table, values, action="set", tag="Entry", indent=8):
    """The most common shape by far: one <Entry> of flat fields in a table."""
    return doc(table, el(tag, fields(values, indent + 4), indent), action)


def mac_ace_param(side, value, indent=16):
    """One address half of a MAC ACL rule.

    Copied from how confd assembled these by hand (switch_mac.py:253-276)
    rather than from a template, because it is the one block it built as a
    string: addressType 4 means "any" and carries no address, while type 1
    carries an address and a mask width. Getting that wrong produces an ACE
    the switch accepts and then never matches.
    """
    pad = " " * indent
    if (value or "").strip().lower() == "any":
        return f"{pad}<{side}AddressType>4</{side}AddressType>"
    mac, _, bits = value.partition("/")
    return (f"{pad}<{side}AddressType>1</{side}AddressType>\n"
            f"{pad}<{side}MACAddress>{xesc(mac.strip())}</{side}MACAddress>\n"
            f"{pad}<{side}MaskBits>{xesc(bits.strip() or '48')}</{side}MaskBits>")


# ================================================================== client
class Switch:
    def __init__(self, ip=SW_IP, user=SW_USER, password=SW_PASS):
        self.ip, self.user, self.password = ip, user, password
        self.sid = None
        self.ctx = ssl.create_default_context()
        self.ctx.check_hostname = False
        self.ctx.verify_mode = ssl.CERT_NONE

    def login(self):
        url = (f"https://{self.ip}/System.xml?action=login"
               f"&user={self.user}&password={self.password}")
        try:
            f = urllib.request.urlopen(url, context=self.ctx, timeout=10)
        except Exception as e:
            raise SwitchError(f"cannot reach {self.ip}: {e}")
        body = f.read().decode("utf8", "replace")
        # The token arrives in the sessionID RESPONSE HEADER, not the body.
        self.sid = f.headers.get("sessionid") or f.headers.get("sessionID")
        if not self.sid:
            raise SwitchError(f"login returned no sessionid header:\n{body[:300]}")
        # switch-confd disables the web idle timeout right after login;
        # without this, long-lived sessions get dropped mid-use.
        try:
            self.post("<?xml version='1.0' encoding='utf-8'?>"
                      "<DeviceConfiguration><version>1.0</version>"
                      "<EWSServiceTable action=\"set\"><Entry>"
                      "<maxIdleTimeOut>0</maxIdleTimeOut>"
                      "</Entry></EWSServiceTable></DeviceConfiguration>")
        except SwitchError:
            pass
        return self.sid

    def logout(self):
        if not self.sid:
            return
        try:
            req = urllib.request.Request(
                f"https://{self.ip}/System.xml?action=logout",
                headers={"sessionid": self.sid})
            urllib.request.urlopen(req, context=self.ctx, timeout=5).read()
        except Exception:
            pass
        self.sid = None

    def _request(self, url, data=None, retry=True):
        if not self.sid:
            self.login()
        req = urllib.request.Request(url, headers={"sessionid": self.sid},
                                     data=data)
        try:
            body = urllib.request.urlopen(
                req, context=self.ctx, timeout=15).read().decode("utf8", "replace")
        except Exception as e:
            raise SwitchError(str(e))
        if "not authenticated" in body.lower() and retry:
            self.sid = None
            return self._request(url, data, retry=False)
        return body

    def get(self, table):
        # urllib sends {} literally. curl would eat them without -g (globbing).
        return self._request(f"https://{self.ip}/wcd?{{{table}}}")

    def post(self, xml):
        return self._request(f"https://{self.ip}/wcd?", data=xml.encode("utf8"))

    @staticmethod
    def _rows(body, tag, fields, within=None):
        try:
            root = ET.fromstring(body)
        except ET.ParseError as e:
            raise SwitchError(f"bad XML: {e}")
        # A multi-table GET returns both tables in one document, so scope the
        # search to the right one instead of iterating the whole tree.
        scope = root if within is None else root.find(f".//{within}")
        if scope is None:
            return []
        return [{f: (el.findtext(f) or "").strip() for f in fields}
                for el in scope.iter(tag)]

    def ports(self):
        return self._rows(self.get("Standard802_3List"), "Entry", PORT_FIELDS)

    @staticmethod
    def _lags(body):
        """LAG1-4 with their member ports.

        Confirmed against hardware: all four groups always exist, each with a
        PortList that is empty until ports are bound. switch_port_info.py:563
        walks LAGEntry/PortList/PortEntry exactly like this.

        Standard802_3List does also report a LAGID per port, so membership
        could be derived from the ports table alone - but only PortEntry
        carries membershipType, which is what distinguishes a member that is
        forwarding from one that is merely bound. Hence this table.
        """
        try:
            root = ET.fromstring(body)
        except ET.ParseError as e:
            raise SwitchError(f"bad XML: {e}")
        out = []
        for e in root.iter("LAGEntry"):
            members = [{"portName": (p.findtext("portName") or "").strip(),
                        "membershipType": (p.findtext("membershipType") or "").strip()}
                       for p in e.iter("PortEntry")]
            out.append({"interfaceName": (e.findtext("interfaceName") or "").strip(),
                        "members": [m for m in members if m["portName"]]})
        return out

    def port_snapshot(self):
        """Everything the Ports view needs, in ONE GET.

        switch_port_info.py:550 already combines {Standard802_3List}{LAGList};
        the wcd API takes any number of tables, so counters and the MAC table
        ride along at no extra round trip. They have to be read together
        anyway - LAG membership, "is this link actually carrying anything",
        and "what is on the other end" are only meaningful against the port
        list they were sampled with.

        Returns {"ports", "lags", "stats", "macs"}.
        """
        body = self._request(f"https://{self.ip}/wcd?"
                             f"{{Standard802_3List}}{{LAGList}}"
                             f"{{StatisticsList}}{{ForwardingTable}}")
        ports = self._rows(body, "Entry", PORT_FIELDS, within="Standard802_3List")
        if not ports:
            # Should not happen, but never lose the Ports view over a wrapper
            # element that is not shaped the way we expect.
            ports = self._rows(body, "Entry", PORT_FIELDS, within="DeviceConfiguration")
        stats = {r["interfaceName"]: r
                 for r in self._rows(body, "InterfaceStatisticsEntry", STAT_FIELDS)}
        macs = self._rows(body, "Entry", MAC_FIELDS, within="ForwardingTable")
        return {"ports": ports, "lags": self._lags(body),
                "stats": stats, "macs": macs}

    def poe(self):
        return self._rows(self.get("PoEPSEInterfaceList"), "Interface",
                          ["interfaceName", "adminEnable", "detectionStatus",
                           "powerClassification", "outputPower", "powerLimit"])

    def vlans(self):
        return self._rows(self.get("VLANInterfaceMembershipTable"), "Entry",
                          ["VLANID", "VLANName", "taggedPorts", "untaggedPorts"])

    def vlan_interfaces(self):
        """Per-port VLAN config - which VLANs a port carries and how."""
        return self._rows(self.get("VLANInterfaceISList"), "Entry",
                          VLANIF_FIELDS)

    def set_vlan_interface(self, ifname, mode=None, pvid=None, tagged=None,
                           untagged=None, forbidden=None, trunk_native=None,
                           trunk_members=None, access_pvid=None):
        """Set one port's VLAN configuration.

        Same shape switch-confd used for switchport mode / PVID / tagged /
        untagged (xml_post_giga_swport_mode_str and friends), collapsed into
        one Entry so a port lands in a consistent state in a single write.

        Every field is optional and an omitted one is left alone, because the
        access and trunk fields are only meaningful in their own mode - a
        general-mode port has no trunkNativeVID, and writing one anyway makes
        the switch reject the whole Entry.
        """
        return self.post(entry_doc("VLANInterfaceISList", {
            "interfaceName": ifname,
            "switchportModeAdmin": mode,
            "generalPVID": pvid,
            "generalTaggedVLANs": tagged,
            "generalUntaggedVLANs": untagged,
            "generalForbiddenVLANs": forbidden,
            "accessPVID": access_pvid,
            "trunkNativeVID": trunk_native,
            "trunkMemberVLANs": trunk_members,
        }))

    def clear_vlan_interface(self, ifname, *field_names):
        """Clear VLAN list fields on a port, the way confd did.

        action="restore" with SELF-CLOSING elements
        (xml_post_no_giga_tagged_vlan_str / _untagged_ / _forbid_). This is
        NOT interchangeable with setting an empty value: posting
        action="set" with <generalTaggedVLANs></generalTaggedVLANs> hangs
        the switch until AC is removed. Verified the hard way twice on
        2026-08-11.
        """
        if not field_names:
            raise SwitchError("clear_vlan_interface: nothing to clear")
        body = ["        <Entry>",
                f"            <interfaceName>{xesc(ifname)}</interfaceName>"]
        body += [f"            <{f}/>" for f in field_names]
        body.append("        </Entry>")
        return self.post(doc("VLANInterfaceISList", "\n".join(body),
                             "restore"))

    def macs(self):
        return self._rows(self.get("ForwardingTable"), "Entry",
                          ["VLANID", "MACAddress", "interfaceName", "addressType"])

    def stats(self):
        return self._rows(self.get("StatisticsList"), "InterfaceStatisticsEntry",
                          ["interfaceName", "receivePacketByteCount",
                           "receiveUnicastPacketCount", "transmitPacketByteCount",
                           "transmitUnicastPacketCount", "packetErrorCount"])

    # ---- generic reads --------------------------------------------------
    @staticmethod
    def _any(body, tag, within=None):
        """Rows as {element: text} for EVERY child, not a fixed field list.

        The named-field reader above exists for the views whose columns were
        worked out against hardware. For the tables added later there is no
        such certainty: switch-confd only ever wrote most of them, so the
        exact set of elements the firmware reports back is not documented
        anywhere and differs per table. Taking whatever arrives keeps a
        column that happens to be missing from blanking the whole view, and
        lets the detail panel show fields nobody predicted.
        """
        try:
            root = ET.fromstring(body)
        except ET.ParseError as e:
            raise SwitchError(f"bad XML: {e}")
        scope = root if within is None else root.find(f".//{within}")
        if scope is None:
            return []
        out = []
        for e in scope.iter(tag):
            row = {}
            for child in e:
                # Flatten one level of nesting so <BridgeSetting><maxAge>
                # lands as "maxAge" rather than vanishing.
                if len(child):
                    for g in child:
                        row[g.tag] = (g.text or "").strip()
                else:
                    row[child.tag] = (child.text or "").strip()
            out.append(row)
        return out

    def read(self, table, tag="Entry", within=None):
        """GET one table and return its rows with every element they carry."""
        return self._any(self.get(table), tag, within if within else table)

    def read_one(self, table, tag=None):
        """A table that holds a single settings block rather than a list."""
        rows = self._any(self.get(table), tag or table)
        return rows[0] if rows else {}

    # ---- writes -------------------------------------------------------
    def set_port_admin(self, ifname, up):
        return self.post(entry_doc("Standard802_3List", {
            "interfaceName": ifname, "adminState": "1" if up else "2"}))

    def set_port(self, ifname, values):
        """Any other Standard802_3List field on one port.

        Covers speed (speedAdmin), duplex (duplexAdminMode), autonegotiation,
        flow control, MDIX and the interface description - all of which are
        separate xml_post_giga_*_str templates in confd and the same one-field
        write here.
        """
        values = dict(values)
        values["interfaceName"] = ifname
        return self.post(entry_doc("Standard802_3List", values))

    def set_poe(self, ifname, on):
        return self.post(entry_doc("PoEPSEInterfaceList", {
            "interfaceName": ifname, "adminEnable": "1" if on else "2"},
            tag="Interface"))

    def set_poe_port(self, ifname, values):
        """Other PoE fields on one port - in practice, the power limit.

        Cisco's templates also write priority, 4-pair and powered-device
        class, but this firmware does not report those back: measured
        2026-08-12, PoEPSEInterfaceList returns only adminEnable,
        detectionStatus, interfaceName, outputPower, powerClassification
        and powerLimit. Writing the others is accepted and unverifiable,
        so treat powerLimit as the only useful field here.
        """
        values = dict(values)
        values["interfaceName"] = ifname
        return self.post(entry_doc("PoEPSEInterfaceList", values,
                                   tag="Interface"))

    # LAG membership is a property of the MEMBER PORT, not of the LAG: the
    # write targets the port's own Standard802_3List entry and names the group
    # in LAGID. Verbatim from switch-confd's xml_post_channel_group_str
    # (switch_interfaces.py:1035, driven by SET_IFACE_CHANNEL_GROUP).
    #
    # Unbinding is LAGID 0 with mode 0, which is what confd sends for
    # "no channel-group" (switch_interfaces.py:7061).
    def set_channel_group(self, ifname, lag_id, mode):
        return self.post(entry_doc("Standard802_3List", {
            "interfaceName": ifname, "LACPEnabled": mode, "LAGID": lag_id}))

    def vlan(self, vid, create=True, name=None):
        """Create/modify or delete a VLAN.

        A name is optional; confd sent it as a second write
        (xml_vlanlist_name_str) but the element belongs to the same VLAN
        entry, so one write does both.
        """
        return self.post(doc(
            "VLANList",
            el("VLAN", fields({"VLANID": vid, "VLANName": name}, 12)),
            "set" if create else "delete"))

    def flush_macs(self, ifname=None):
        """Forget learned MAC addresses - all of them, or one port's.

        Two different shapes, both from switch_action.py:4773-4786. The
        deleteAll form is a self-closing element and carries no <version>;
        that is exactly what confd sent, so it is reproduced rather than
        tidied up.
        """
        if ifname:
            return self.post(entry_doc("ForwardingTable",
                                       {"interfaceName": ifname},
                                       action="delete"))
        return self.post("<?xml version='1.0' encoding='utf-8'?>\n"
                         "<DeviceConfiguration>\n"
                         '    <ForwardingTable action="deleteAll"/>\n'
                         "</DeviceConfiguration>")

    def clear_counters(self, ifname):
        """Zero the statistics for one port (xml_post_clear_counters_str).

        Note this is a table of its own, not an Entry - the port name goes
        straight into <clearPorts>.
        """
        return self.post(doc("PortStatisticsClear",
                             fields({"clearPorts": ifname})))

    # ---- spanning tree ---------------------------------------------------
    # Two tables, and the split is not obvious: whether STP runs at all and
    # in which mode lives in SpanningTreeGlobalParam, while the timers, the
    # bridge priority and everything per-port live in STP. RSTP and MSTP*
    # hold only the fields unique to those modes.
    def stp_global(self):
        return self.read_one("SpanningTreeGlobalParam")

    def stp(self):
        """Global STP settings plus the per-port list, in one GET."""
        body = self.get("STP")
        glob = self._any(body, "GlobalSetting")
        ports = self._any(body, "InterfaceEntry")
        return {"global": glob[0] if glob else {}, "ports": ports}

    def set_stp_enabled(self, on):
        return self.post(doc("SpanningTreeGlobalParam",
                             fields({"enabled": "1" if on else "2"})))

    def set_stp_mode(self, mode):
        return self.post(doc("SpanningTreeGlobalParam",
                             fields({"STPOperationMode": mode})))

    def set_stp_bridge(self, values):
        """forwardDelay / helloTime / maxAge / bridgePriority.

        These sit one level deeper than the rest of GlobalSetting, inside
        BridgeSetting - see xml_post_stp_forward_time_str.
        """
        return self.post(doc("STP", el("GlobalSetting", el(
            "BridgeSetting", fields(values, 16), 12), 8)))

    def set_stp_setting(self, values):
        """BPDUHandlingMode / pathCostDefaultValueType / loopbackGuardEnable."""
        return self.post(doc("STP", el("GlobalSetting", fields(values, 12), 8)))

    def set_stp_port(self, ifname, values, table="STP"):
        """Per-port STP. table="RSTP" for the point-to-point link type."""
        values = dict(values)
        values["interfaceName"] = ifname
        return self.post(doc(table, el("InterfaceList", el(
            "InterfaceEntry", fields(values, 16), 12), 8)))

    def mstp_global(self):
        return self.read_one("MSTPGlobalSetting")

    def set_mstp_global(self, values):
        return self.post(doc("MSTPGlobalSetting", fields(values, 8)))

    def set_mstp_region(self, name):
        return self.post(doc("MSTP", el("GlobalSetting",
                                        fields({"regionName": name}, 12), 8)))

    def mstp_instances(self):
        return self.read("MSTPInstanceList")

    def set_mstp_instance(self, inst, values):
        values = dict(values)
        values["instanceID"] = inst
        return self.post(entry_doc("MSTPInstanceList", values))

    def mstp_vlans(self):
        return self.read("MSTPVLANList")

    def set_mstp_vlans(self, inst, vlanlist, add=True):
        return self.post(entry_doc(
            "MSTPVLANList", {"instanceID": inst, "VLANList": vlanlist},
            action="add" if add else "delete"))

    def set_mstp_port(self, inst, ifname, values):
        values = dict(values)
        values["instanceID"], values["interfaceName"] = inst, ifname
        return self.post(entry_doc("MSTPInterfaceList", values))

    # ---- storm control ---------------------------------------------------
    def storm(self):
        return self.read("StormControlTable")

    def set_storm(self, ifname, kind, value, unit=STORM_LEVEL):
        """Rate-limit broadcast / unicast / multicast flooding on one port.

        kind is "broadcast", "unicast" or "multicast". A value of 0 is how
        confd turns a class off (xml_no_storm_control_broadcast_str), not a
        delete. Multicast additionally needs multicastType, which confd
        always sent as 4.
        """
        values = {"interfaceName": ifname,
                  f"{kind}RateValue": value,
                  f"{kind}UnitType": unit}
        if kind == "multicast":
            values["multicastType"] = "4"
        return self.post(entry_doc("StormControlTable", values))

    # ---- port mirroring (SPAN) -------------------------------------------
    def span_sources(self):
        return self.read("SpanSourceTable")

    def span_destinations(self):
        return self.read("SpanDestinationTable")

    def add_span_source(self, session, ifname=None, vlan=None,
                        direction=SPAN_BOTH):
        """Mirror a port or a VLAN into a session.

        sourceType 1 is an interface and 2 a local VLAN; the index is not the
        port name but Cisco's own numbering - see span_index().
        """
        if vlan:
            stype, idx = "2", span_vlan_index(vlan)
        else:
            stype, idx = "1", span_index(ifname)
        return self.post(entry_doc("SpanSourceTable", {
            "sessionId": session, "sourceType": stype, "sourceIdx": idx,
            "sourceDirection": direction}, action="add"))

    def del_span_source(self, session, ifname=None, vlan=None,
                        direction=SPAN_BOTH):
        if vlan:
            stype, idx = "2", span_vlan_index(vlan)
        else:
            stype, idx = "1", span_index(ifname)
        return self.post(entry_doc("SpanSourceTable", {
            "sessionId": session, "sourceType": stype, "sourceIdx": idx,
            "sourceDirection": direction}, action="delete"))

    def set_span_destination(self, session, ifname, analyzer=True):
        """Where the mirrored copy comes out.

        isReflector 1 and a port type of analyzer/network is the local-SPAN
        case; remote SPAN needs a reflector port and a remote VLAN, which
        this does not do.
        """
        return self.post(entry_doc("SpanDestinationTable", {
            "sessionId": session, "ifIndex": span_index(ifname),
            "isReflector": "1",
            "portType": SPAN_ANALYZER if analyzer else SPAN_NETWORK,
            "remoteVlanId": "0"}, action="add"))

    def del_span_destination(self, session):
        return self.post(entry_doc("SpanDestinationTable",
                                   {"sessionId": session}, action="delete"))

    # ---- static MAC and aging --------------------------------------------
    def static_macs(self):
        return self.read("ForwardingStaticTable")

    def forwarding_global(self):
        return self.read_one("ForwardingGlobalSetting")

    def set_mac_aging(self, seconds):
