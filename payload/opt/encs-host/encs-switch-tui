    def acls(self):
        return self.read("ACLList", tag="ACLEntry")

    def aces(self):
        return self.read("ACEList")

    def acl_bindings(self):
        return self.read("ACLBindingList", tag="ACLBindingEntry")

    def acl(self, name, acl_type=ACL_MAC, create=True):
        return self.post(entry_doc(
            "ACLList", {"ACLName": name, "ACLType": acl_type},
            action="set" if create else "delete", tag="ACLEntry"))

    def set_ace(self, name, priority, action_, params, rule_type=ACL_MAC,
                create=True):
        """One rule inside an ACL.

        params is the already-built <MACParameters>/<IPv4Parameters> block,
        because the two rule types carry completely different children and
        collapsing them would hide which fields are legal where.
        """
        return self.post(doc("ACEList", el("Entry", fields({
            "ACLName": name, "ruleType": rule_type, "ruleAction": action_,
            "rulePriority": priority}, 12) + "\n" + params),
            "set" if create else "delete"))

    def bind_acl(self, ifname, name, action_=ACL_DENY, outbound=False):
        """Attach an ACL to a port.

        interfaceType 2 and bindingType 5 are what confd sent for a physical
        port (xml_post_acl_input_action_str); the outbound direction uses
        different element names for the same two values.
        """
        if outbound:
            names = {"defaultRuleActionOut": action_,
                     "ACLIPv4MACNameOut": name}
        else:
            names = {"defaultRuleAction": action_, "ACLIPv4MACName": name}
        values = {"interfaceType": "2", "interfaceName": ifname}
        values.update(names)
        values["bindingType"] = "5"
        return self.post(entry_doc("ACLBindingList", values,
                                   tag="ACLBindingEntry"))

