    def act_port_settings(self):
        """Description, speed, duplex and flow control on the selected port.

        Duplex was withheld until 2026-08-12, when a link partner settled
        it: duplexAdminMode and duplexOperMode are two different enums,
        inverted relative to each other. Forcing admin 3 brought the link
        up reporting oper 2 (full), so "full" is proven. "half" is Cisco's
        value, consistent with what was measured but not confirmed - the
        prompt says so rather than pretending otherwise.
        """
        r = self.cur()
        if not r:
            return
        n = r["interfaceName"]
        what = self.ask_pick(f"{n} settings", {
            "d": ("desc", "description"), "s": ("speed", "speed"),
            "x": ("duplex", "duplex"), "f": ("flow", "flow control")})
        if what is None:
            return
        if what == "duplex":
            v = self.ask_pick("duplex ('half' is unverified on this "
                              "firmware)", {
                                  "a": ("auto", "autonegotiate"),
                                  "f": (DUPLEX_ADMIN_FULL, "full"),
                                  "h": (DUPLEX_ADMIN_HALF, "half")})
            if v is None:
                return
            if n.startswith("te"):
                self.set_msg(f"{n} is a backplane serdes - forcing its "
                             f"duplex is not meaningful", bad=True)
                return
            if v == "auto":
                self.write(f"{n} autonegotiate",
                           lambda: self.sw.set_port(
                               n, {"autoNegotiationAdminEnabled": "1"}))
            else:
                # Forcing duplex means autonegotiation off, same as speed -
                # otherwise the switch keeps negotiating and ignores it.
                self.write(f"{n} forced {DUPLEX_ADMIN[v]} duplex",
                           lambda: self.sw.set_port(
                               n, {"autoNegotiationAdminEnabled": "2",
                                   "duplexAdminMode": v}))
            return
        if what == "desc":
            v = self.ask_text(f"description for {n}", maxlen=64)
            if v is None:
                return
            self.write(f"{n} described",
                       lambda: self.sw.set_port(n, {"interfaceDescription": v}))
        elif what == "speed":
            v = self.ask_pick("speed", {
                "a": ("auto", "autonegotiate"), "1": ("1000", "1000 Mb/s"),
                "0": ("100", "100 Mb/s"), "t": ("10", "10 Mb/s")})
            if v is None:
                return
            if n.startswith("te") and v != "auto":
                self.set_msg(f"{n} is a 10GBASE-KR backplane serdes - "
                             f"forcing its speed is not meaningful", bad=True)
                return
            if v == "auto":
                # Auto is not a speed value; it is autonegotiation back on.
                self.write(f"{n} autonegotiate",
                           lambda: self.sw.set_port(
                               n, {"autoNegotiationAdminEnabled": "1"}))
            else:
                # Forcing a speed means turning autoneg off in the same
                # write, or the switch keeps negotiating and ignores it.
                self.write(f"{n} forced to {v} Mb/s",
                           lambda: self.sw.set_port(
                               n, {"autoNegotiationAdminEnabled": "2",
                                   "speedAdmin": v}))
        else:
            v = self.ask_pick("flow control", {"y": ("1", "on"),
                                               "n": ("2", "off")})
            if v:
                self.write(f"{n} flow control {'on' if v == '1' else 'off'}",
                           lambda: self.sw.set_port(
                               n, {"flowControlAdminType": v}))

