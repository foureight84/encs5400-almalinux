               "receiveUnicastPacketCount", "transmitPacketByteCount",
               "transmitUnicastPacketCount", "packetErrorCount"]
MAC_FIELDS = ["VLANID", "MACAddress", "interfaceName", "addressType"]
# Per-interface VLAN config: which VLANs a port is in and how it tags them.
# switchportModeAdmin: 10 general, 11 access, 12 trunk, 13 private, 15 customer
# (switch_interfaces.py SWITCH_SWPORT_MODE_*).
VLANIF_FIELDS = ["interfaceName", "switchportModeAdmin", "generalPVID",
                 "generalTaggedVLANs", "generalUntaggedVLANs",
                 "accessPVID", "trunkNativeVID", "trunkMemberVLANs"]
SWPORT_MODE = {"10": "general", "11": "access", "12": "trunk",
