def span_index(ifname):
    """Port name -> the ifIndex the SPAN tables use.

    gi0-gi7 are 1-8 and te1-te4 are 9-12 (switch_monitor.py:449 on the way
    in, :164 on the way back). Every other table in this API takes the port
    NAME, so this is the one place a number is required.
    """
    m = re.fullmatch(r"(gi|te)(\d+)", ifname or "")
    if not m:
        raise SwitchError(f"{ifname} cannot be a SPAN port")
    n = int(m.group(2))
    return str(n + SPAN_GE_OFFSET if m.group(1) == "gi"
               else n + SPAN_TE_OFFSET)


def span_ifname(index):
    """The inverse, for displaying what a session is already mirroring."""
    try:
        i = int(index)
    except (TypeError, ValueError):
        return str(index)
    if i >= SPAN_VLAN_OFFSET:
        return f"VLAN {i - SPAN_VLAN_OFFSET + 1}"
    return f"gi{i - SPAN_GE_OFFSET}" if i <= SPAN_TE_OFFSET \
        else f"te{i - SPAN_TE_OFFSET}"


def span_vlan_index(vid):
    """VLAN id -> source index (switch_monitor.py:345). Off by one: VLAN 1
    is the offset itself, not offset+1."""
    return str(SPAN_VLAN_OFFSET + int(vid) - 1)


