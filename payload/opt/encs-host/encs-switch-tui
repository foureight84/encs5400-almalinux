# ==================================================================== UI
VIEWS = [("ports", "p"), ("vlans", "v"), ("poe", "e"),
         ("mac", "m"), ("stats", "s"), ("config", "c"), ("help", "?")]

C_OK, C_BAD, C_HDR, C_WARN, C_DIM = 1, 2, 3, 4, 5


class UI:
    def __init__(self, stdscr, sw):
        self.s, self.sw = stdscr, sw
        self.view = "ports"
        self.sel = 0
        self.top = 0
        self.msg = ""
        self.msg_bad = False
        self.detail = True
        self.help_scroll = 0
        self.data = {}
        self.last_refresh = 0
        self.connected = True
        self.update_tag = None
        self._check_update_bg()
        curses.curs_set(0)
        self.s.timeout(1000)
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(C_OK, curses.COLOR_GREEN, -1)
            curses.init_pair(C_BAD, curses.COLOR_RED, -1)
            curses.init_pair(C_HDR, curses.COLOR_CYAN, -1)
            curses.init_pair(C_WARN, curses.COLOR_YELLOW, -1)
            curses.init_pair(C_DIM, curses.COLOR_BLUE, -1)

    def _check_update_bg(self):
        """One-shot release check at startup, off the UI thread.

        Failures are swallowed on purpose. A host with no route to github.com
        is an entirely normal deployment - this VLAN is link-local and plenty
        of these boxes are isolated - and it must not produce an error banner.
        Set ENCS_NO_UPDATE_CHECK=1 to skip the request altogether.
        """
        if os.environ.get("ENCS_NO_UPDATE_CHECK"):
            return

        def run():
            try:
                tag, newer, _ = check_update()
                if newer:
                    self.update_tag = tag
            except Exception:
                pass

        threading.Thread(target=run, daemon=True).start()

    # ---------------------------------------------------------- data
    def refresh_data(self, force=False):
        try:
            if self.view == "ports":
                snap = self.sw.port_snapshot()
                self.data["ports"] = snap["ports"]
                self.data["lags"] = snap["lags"]
                self.data["portstats"] = snap["stats"]
                self.data["portmacs"] = snap["macs"]
            elif self.view == "poe":
                self.data["poe"] = self.sw.poe()
            elif self.view == "vlans":
                self.data["vlans"] = self.sw.vlans()
            elif self.view == "mac":
                self.data["mac"] = self.sw.macs()
            elif self.view == "stats":
                self.data["stats"] = self.sw.stats()
            self.connected = True
            self.last_refresh = time.time()
        except SwitchError as e:
            self.connected = False
            self.set_msg(f"{e}", bad=True)

    def rows(self):
        return self.data.get(self.view, [])

    def lag_map(self):
        """member port name -> (LAG name, membershipType or "").

        Membership comes from the port's own LAGID, which is the stored
        CONFIGURATION and is unambiguous: 0 unbound, N bound to LAGN,
        regardless of admin or link state.

        It deliberately does NOT come from LAGList's membershipType. That is
        an OPERATIONAL signal and varies with mode - measured on hardware, a
        bound-but-down port reads 3 ("not candidate") under auto/LACP but 2
        ("inactive") under on/static. Treating 3 as "not a member" made a
        freshly bound port look unbound and silently dropped it from the
        saved config, which on a switch whose ports boot SHUT is the normal
        case, not an edge case.
        """
        state = {m["portName"]: m["membershipType"]
                 for lag in self.data.get("lags", []) for m in lag["members"]}
        out = {}
        for p in self.data.get("ports", []):
            n = p["interfaceName"]
            lid = (p.get("LAGID") or "").strip()
            if not n.startswith("LAG") and lid.isdigit() and int(lid) > 0:
                out[n] = (f"LAG{int(lid)}", state.get(n, ""))
        return out

    def peer_map(self):
        """switch port -> name of the host NIC on the other end of it.

        Derived, never hardcoded: cross-references the switch's own MAC table
        against this machine's NICs. That is what makes it correct on any
        chassis - MACs differ per unit, so a baked-in table would be wrong
        everywhere but here.

        A port only appears once the far end has actually sent a frame. An
        admin-down NIC never does, so a silent backplane link stays blank -
        which is itself the useful signal.
        """
        nics = local_nics()
        out = {}
        for m in self.data.get("portmacs", []):
            nic = nics.get(m["MACAddress"].strip().lower())
            if nic and m["interfaceName"]:
                out.setdefault(m["interfaceName"], nic)
        return out

    def mgmt_port(self):
        """The switch port this session's traffic actually arrives on.

        Derived, not assumed: a local NIC's MAC learned in the management
        VLAN. Shutting this port ends the session, and with no flash on the
        ASIC the only way back is a cold power cycle that wipes everything.
        """
        nics = local_nics()
        for m in self.data.get("portmacs", []):
            if (m["VLANID"] == MGMT_VLAN
                    and m["MACAddress"].strip().lower() in nics):
                return m["interfaceName"]
        return None

    def rx_idle(self, ifname):
        """True if the link is up but has never received a unicast frame.

        The trap this exists for: a 10GBASE-KR backplane link stays trained
        even when the host NIC at the far end is administratively down, so the
        switch reports it UP while nothing whatsoever is arriving. "up" is a
        statement about the serdes, not about traffic.
        """
        s = self.data.get("portstats", {}).get(ifname)
        if not s:
            return False
        return (s.get("receiveUnicastPacketCount") or "0").strip() in ("0", "")

    def set_msg(self, m, bad=False):
        self.msg, self.msg_bad = m, bad

    # ---------------------------------------------------------- chrome
    def draw(self):
        self.s.erase()
        h, w = self.s.getmaxyx()

        state = "connected" if self.connected else "UNREACHABLE"
        # No "updated Ns ago": the views that need it auto-refresh anyway, so
        # the age was noise. That space now carries the update notice instead.
        note = (f"   UPDATE {self.update_tag} AVAILABLE - Config view, u"
                if self.update_tag else "")
        title = f" ENCS 5412 switch  {self.sw.ip}  [{state}]{note} "
        attr = curses.A_REVERSE | (0 if self.connected
                                   else curses.color_pair(C_BAD))
        self.s.addnstr(0, 0, title.ljust(w - 1), w - 1, attr)
        ver = f" v{VERSION} "
        if len(title) + len(ver) < w:
            self.s.addnstr(0, w - 1 - len(ver), ver, len(ver), attr)

        # Draw the tabs one at a time so the active one can carry its own
        # attribute - a single addnstr can only paint the whole strip.
        x = 1
        for n, k in VIEWS:
            active = n == self.view
            label = f" [{k}] {n.upper()} " if active else f" [{k}] {n} "
            if x >= w - 1:
                break
            self.s.addnstr(1, x, label, w - 1 - x,
                           curses.A_REVERSE | curses.A_BOLD if active
                           else curses.color_pair(C_HDR))
            x += len(label)
        self.s.hline(2, 0, curses.ACS_HLINE, w)

        if self.view == "help":
            self.draw_help(3, h, w)
        else:
            # Ports needs the most room: LAG state and the idle-link warning
            # can each add two lines of their own.
            dh = ((9 if self.view == "ports" else 6)
                  if (self.detail and self.view in ("ports", "poe", "vlans")) else 0)
            {"ports": self.d_ports, "poe": self.d_poe, "vlans": self.d_vlans,
             "mac": self.d_mac, "stats": self.d_stats,
             "config": self.d_config}[self.view](3, h - dh - 3, w)
            if dh:
                self.draw_detail(h - dh - 3, h, w)

        keys = {
            "ports": ("SPACE enable/disable port   g LAG   r refresh   "
                      "i detail   ? help   q quit"),
            "poe": "SPACE PoE on/off   r refresh   i detail   ? help   q quit",
            "vlans": "n new   d delete   r refresh   i detail   ? help   q quit",
            "config": ("w write config   a apply config   u check update   "
                       "? help   q quit"),
            "help": "arrows scroll   any other key returns",
        }.get(self.view, "r refresh   ? help   q quit")
        self.s.hline(h - 3, 0, curses.ACS_HLINE, w)
        self.s.addnstr(h - 2, 1, keys, w - 2, curses.A_DIM)
        if self.msg:
            self.s.addnstr(h - 1, 1, self.msg[:w - 2], w - 2,
                           curses.color_pair(C_BAD if self.msg_bad else C_WARN))
        self.s.refresh()

    def draw_help(self, y, h, w):
        lines = []
        for title, body in MANUAL:
            lines.append(("H", title))
            for para in body.format(ip=self.sw.ip, cfg=CFG_DIR,
                                    ver=VERSION).split("\n"):
                for wrapped in (textwrap.wrap(para, w - 6) or [""]):
                    lines.append(("T", wrapped))
            lines.append(("T", ""))
        maxs = max(0, len(lines) - (h - y - 4))
        self.help_scroll = max(0, min(self.help_scroll, maxs))
        for i, (kind, text) in enumerate(lines[self.help_scroll:]):
            if y + i >= h - 4:
                break
            if kind == "H":
                self.s.addnstr(y + i, 2, text, w - 3,
                               curses.A_BOLD | curses.color_pair(C_HDR))
            else:
                self.s.addnstr(y + i, 4, text, w - 5)
        if maxs:
            pct = int(100 * self.help_scroll / maxs)
            self.s.addnstr(h - 4, w - 12, f"-- {pct:3d}% --", 11, curses.A_DIM)

    def draw_detail(self, y, h, w):
        self.s.hline(y, 0, curses.ACS_HLINE, w)
        rows = self.rows()
        if not rows or self.sel >= len(rows):
            return
        r = rows[self.sel]
        out = []
        if self.view == "ports":
            n = r["interfaceName"]
            role = PORT_ROLE.get(n[:2], "")
            pl = panel_label(n)
            head = f"{n}  -  {role}"
            if pl != "-":
                head = f"{n}  =  front panel {pl}  -  {role}"
            peer = self.peer_map().get(n)
            if peer:
                head += f"  ->  this host's {peer}"
            st = self.data.get("portstats", {}).get(n, {})
            out = [head,
                   f"  link {LINK.get(r['linkState'],'?')}   "
                   f"admin {ADMIN.get(r['adminState'],'?')}   "
                   f"{r['speedOper']} Mb/s {DUPLEX.get(r['duplexOperMode'],'-')}   "
                   f"media {media_label(n, r['mediaType'])}",
                   f"  mac  {r['MACAddress']}"
                   + (f"   rx {st.get('receiveUnicastPacketCount','?')} pkts"
                      f"   tx {st.get('transmitUnicastPacketCount','?')} pkts"
                      if st else "")]
            if r["linkState"] == "1" and self.rx_idle(n):
                out.append("  UP BUT IDLE - nothing has arrived on this port. A "
                           "backplane link stays trained even")
                out.append("  when the NIC at the far end is down, so UP here "
                           "means the serdes, not traffic.")
            lm = self.lag_map()
            if n.startswith("LAG"):
                mem = [(p, s) for p, (g, s) in sorted(lm.items()) if g == n]
                if mem:
                    out.append("  members: " + ", ".join(
                        f"{p} ({LAG_MEMBER.get(s, s)})" for p, s in mem))
                else:
                    out.append("  no members - select a gi port and press g "
                               "to add one.")
            elif n in lm:
                gname, st = lm[n]
                mode = CG_MODE.get(r.get("LACPEnabled", ""), "unknown mode")
                out.append(f"  bundled into {gname} ({mode})"
                           + (f" - {LAG_MEMBER[st]}" if st in LAG_MEMBER else "")
                           + ".  g rebinds or removes it.")
                if st == "2":
                    out.append("  inactive: in the group but not forwarding. "
                               "Usually the far end is not bundling this port.")
                elif st == "3":
                    out.append("  not candidate: configured, but cannot join "
                               "yet - a shut or link-down port")
                    out.append("  cannot run LACP. It is still saved and will "
                               "be replayed.")
            if r["adminState"] == "2":
                out.append("  DISABLED - you have not enabled this port, so "
                           "it will not pass traffic. SPACE enables it.")
            elif r["linkState"] != "1" and not n.startswith("LAG"):
                out.append("  enabled but no link - nothing plugged in, "
                           "or the far end is down.")
        elif self.view == "poe":
            try:
                ow, lim = int(r["outputPower"]) / 1000, int(r["powerLimit"]) / 1000
            except ValueError:
                ow, lim = 0, 0
            out = [f"{r['interfaceName']}  PoE {POE_ADMIN.get(r['adminEnable'],'?')}",
                   f"  status {POE_DETECT.get(r['detectionStatus'],'?')}   "
                   f"class {r['powerClassification']}   "
                   f"drawing {ow:.1f} W of {lim:.1f} W limit"]
            if r["adminEnable"] == "2":
                out.append("  PoE disabled on this port. SPACE enables it.")
        elif self.view == "vlans":
            out = [f"VLAN {r['VLANID']}  {r['VLANName'] or '(no name)'}",
                   f"  untagged: {r['untaggedPorts'] or '(none)'}",
                   f"  tagged  : {r['taggedPorts'] or '(none)'}"]
            if r["VLANID"] == "2363":
                out.append("  management VLAN - carries this session. Do not remove.")
            elif r["VLANID"] == "1":
                out.append("  default VLAN - all ports are untagged members.")
        for i, t in enumerate(out):
            if y + 1 + i >= h - 3:
                break
            self.s.addnstr(y + 1 + i, 2, t, w - 3,
                           curses.A_BOLD if i == 0 else curses.A_DIM)

    # ---------------------------------------------------------- views
    def _list(self, y, h, w, header, fmt, rows, colour=None):
        self.s.addnstr(y, 2, header, w - 3, curses.A_BOLD | curses.A_UNDERLINE)
        avail = h - y - 1
        if self.sel < self.top:
            self.top = self.sel
        elif self.sel >= self.top + avail:
            self.top = self.sel - avail + 1
        for i, r in enumerate(rows[self.top:self.top + avail]):
            idx = self.top + i
            attr = curses.A_REVERSE if idx == self.sel else 0
            if colour:
                attr |= colour(r)
            self.s.addnstr(y + 1 + i, 2, fmt(r), w - 3, attr)
        if len(rows) > avail:
            self.s.addnstr(y, w - 14, f"{self.sel+1}/{len(rows)}", 12, curses.A_DIM)

    def d_ports(self, y, h, w):
        lm = self.lag_map()
        pm = self.peer_map()

        def lag_col(r):
            n = r["interfaceName"]
            if n.startswith("LAG"):
                # For the group itself, show how many ports it has.
                c = sum(1 for v in lm.values() if v[0] == n)
                return f"{c} ports" if c else "-"
            g = lm.get(n)
            if not g:
                return "-"
            # Bound either way; the suffix is operational state.
            #   (i) inactive      - in the group, not forwarding
            #   (x) not candidate - cannot participate yet, e.g. LACP mode
            #                       on a port that is shut or has no link
            return g[0] + {"1": "", "2": "(i)", "3": "(x)"}.get(g[1], "")

        def link_col(r):
            s = LINK.get(r["linkState"], "?")
            # "idle" reads as what it is: trained, but nothing coming in.
            if r["linkState"] == "1" and self.rx_idle(r["interfaceName"]):
                return "UP idle"
            return s

        self._list(
            y, h, w,
            f"{'port':7}{'panel':7}{'link':9}{'admin':7}{'speed':8}{'media':10}"
            f"{'lag':9}{'attached to':16}mac",
            lambda r: (f"{r['interfaceName']:7}"
                       f"{panel_label(r['interfaceName']):7}"
                       f"{link_col(r):9}{ADMIN.get(r['adminState'],'?'):7}"
                       f"{r['speedOper']:8}"
                       f"{media_label(r['interfaceName'], r['mediaType']):10}"
                       f"{lag_col(r):9}"
                       f"{pm.get(r['interfaceName'], '-'):16}"
                       f"{r['MACAddress']}"),
            self.rows(),
            # Green only when the link is up AND something is arriving on it.
            # Yellow for trained-but-silent, which used to look identical to a
            # working port and is exactly how te1 gets mistaken for in-use.
            lambda r: (curses.color_pair(C_WARN)
                       if r["linkState"] == "1" and self.rx_idle(r["interfaceName"])
                       else curses.color_pair(C_OK) if r["linkState"] == "1"
                       else curses.color_pair(C_BAD) if r["adminState"] == "2"
                       else 0))

    def d_poe(self, y, h, w):
        def f(r):
            try:
                ow, lim = int(r["outputPower"]) / 1000, int(r["powerLimit"]) / 1000
            except ValueError:
                ow = lim = 0.0
            return (f"{r['interfaceName']:8}{POE_ADMIN.get(r['adminEnable'],'?'):7}"
                    f"{POE_DETECT.get(r['detectionStatus'],'?'):13}"
                    f"{r['powerClassification']:7}{ow:>7.1f} W {lim:>7.1f} W")
        self._list(y, h, w,
                   f"{'port':8}{'poe':7}{'status':13}{'class':7}{'draw':>9}{'limit':>10}",
                   f, self.rows(),
                   lambda r: curses.color_pair(C_OK) if r["adminEnable"] == "1" else 0)

    def d_vlans(self, y, h, w):
        self._list(y, h, w,
                   f"{'vlan':8}{'name':14}{'untagged':30}tagged",
                   lambda r: (f"{r['VLANID']:8}{(r['VLANName'] or '-'):14}"
                              f"{(r['untaggedPorts'] or '-'):30}"
                              f"{r['taggedPorts'] or '-'}"),
                   self.rows())

    def d_mac(self, y, h, w):
        self._list(y, h, w, f"{'vlan':8}{'mac':20}{'port':9}type",
                   lambda r: (f"{r['VLANID']:8}{r['MACAddress']:20}"
                              f"{r['interfaceName']:9}"
                              f"{ADDR_TYPE.get(r['addressType'], r['addressType'])}"),
                   self.rows())

    def d_stats(self, y, h, w):
        self._list(y, h, w,
                   f"{'port':8}{'rx bytes':>15}{'rx pkts':>12}"
                   f"{'tx bytes':>15}{'tx pkts':>12}{'errs':>8}",
                   lambda r: (f"{r['interfaceName']:8}"
                              f"{r['receivePacketByteCount']:>15}"
                              f"{r['receiveUnicastPacketCount']:>12}"
                              f"{r['transmitPacketByteCount']:>15}"
                              f"{r['transmitUnicastPacketCount']:>12}"
                              f"{r['packetErrorCount']:>8}"),
                   self.rows(),
                   lambda r: curses.color_pair(C_BAD)
                   if r["packetErrorCount"] not in ("0", "") else 0)

    def d_config(self, y, h, w):
        files = sorted(f for f in os.listdir(CFG_DIR)) \
            if os.path.isdir(CFG_DIR) else []
        body = [
            ("H", "WHY THIS MATTERS"),
            ("T", "The ASIC has no flash. Its config lives in RAM and is LOST on a"),
            ("T", "cold power cycle - it comes back as VLAN 1 + 2363 with every"),
            ("T", "front port SHUT and PoE off. Config DOES survive VM restarts."),
            ("T", ""),
            ("T", f"These files are the switch's real source of truth: {CFG_DIR}"),
            ("T", ""),
            ("H", "ACTIONS"),
            ("T", "  w   write ports / LAGs / VLANs + port membership / PoE"),
            ("T", "  a   apply every *.xml there, in filename order"),
            ("T", ""),
            ("H", "CURRENT FILES"),
        ]
        body += [("T", "  " + f) for f in files] or [("T", "  (none yet - press w)")]
        body += [("T", ""),
                 ("H", "AUTOMATIC REPLAY"),
                 ("T", "encs-switch-replay.service reapplies these after a cold"),
                 ("T", "boot, once the switch answers. Check it with:"),
                 ("T", "  systemctl status encs-switch-replay"),
                 ("T", ""),
                 ("H", f"VERSION {VERSION}"),
                 ("T", "  u   ask GitHub whether a newer release exists"),
                 ("T", "  install it from a root shell, not from here:"),
                 ("T", "        encs-switch-tui --update")]
        for i, (kind, t) in enumerate(body):
            if y + i >= h - 1:
                break
            self.s.addnstr(y + i, 2, t, w - 3,
                           curses.A_BOLD | curses.color_pair(C_HDR)
                           if kind == "H" else 0)

    # ---------------------------------------------------------- input
    def prompt(self, question, maxlen=12):
        """Read a line at the bottom of the screen. Blocking; ESC cancels.

        The screen carries a 1s timeout so the views can auto-refresh. That
        timeout also applied to getstr(), so the old prompt gave up after a
        second and vanished if you did not start typing immediately. Block
        for real here and restore the poll timeout on the way out.

        Returns the text, or None if cancelled.
        """
        h, w = self.s.getmaxyx()
        buf = ""
        curses.curs_set(1)
        self.s.timeout(-1)
        try:
            while True:
                self.s.move(h - 1, 0)
                self.s.clrtoeol()
                self.s.addnstr(h - 1, 1, question, w - 2,
                               curses.color_pair(C_WARN))
                x = min(len(question) + 2, w - 2)
                self.s.addnstr(h - 1, x, buf, max(0, w - 1 - x))
                self.s.refresh()
                c = self.s.getch()
                if c == 27:                                   # ESC
                    return None
                if c in (curses.KEY_ENTER, 10, 13):
                    return buf.strip()
                if c in (curses.KEY_BACKSPACE, 127, 8):
                    buf = buf[:-1]
                elif 32 <= c < 127 and len(buf) < maxlen:
                    buf += chr(c)
        finally:
            curses.curs_set(0)
            self.s.timeout(1000)

    def may_shut(self, ifname):
        """Guard the internal backplane ports against being shut.

        These are real, settable ports - the switch owns its end of each
        backplane link, so shutting te2 drops the management VLAN and this
        session with it, and the ASIC has no flash to recover from. Enabling
        is always allowed; only shutting is refused.
        """
        if not ifname.startswith("te") or ALLOW_TE_SHUT:
            return True
        why = TE_ROLE.get(ifname, "an internal backplane link")
        if ifname == self.mgmt_port():
            self.set_msg(f"REFUSED: {ifname} carries THIS session - {why}. "
                         f"Only a cold power cycle would undo it.", bad=True)
        else:
            self.set_msg(f"REFUSED: {ifname} is {why} - no front-panel jack. "
                         f"Override with ENCS_ALLOW_TE_SHUT=1.", bad=True)
        return False

    def bind_lag(self, p):
        """Add the selected port to a LAG, or take it out of one."""
        name = p["interfaceName"]
        if not name.startswith("gi"):
            self.set_msg(
                "only the gi front ports can join a LAG - te1/te2 are the "
                "backplane links carrying this session", bad=True)
            return
        cur = self.lag_map().get(name)
        v = self.prompt(
            f"{name} is in {cur[0]} - enter LAG 1-{MAX_LAG}, 0 removes it, "
            f"ESC cancels:" if cur
            else f"add {name} to which LAG? 1-{MAX_LAG}, 0 = none, "
                 f"ESC cancels:")
        if v is None or v == "":
            self.set_msg("cancelled")
            return
        if not v.isdigit() or not 0 <= int(v) <= MAX_LAG:
            self.set_msg(f"'{v}' is not a LAG number (0-{MAX_LAG})", bad=True)
            return
        lag_id = int(v)
        if lag_id == 0:
            if not cur:
                self.set_msg(f"{name} is not in a LAG", bad=True)
                return
            self.write(f"{name} leaves {cur[0]}",
                       lambda: self.sw.set_channel_group(name, 0, 0))
            return
        m = self.prompt(f"{name} -> LAG{lag_id} mode: (a)uto = LACP, "
                        f"(o)n = static, ESC cancels:")
        if m is None or m == "":
            self.set_msg("cancelled")
            return
        mode = {"a": CG_AUTO, "o": CG_ON}.get(m[:1].lower())
        if mode is None:
            self.set_msg(f"'{m}' is not a mode - answer a or o", bad=True)
            return
        self.write(f"{name} -> LAG{lag_id} ({CG_MODE[mode]})",
                   lambda: self.sw.set_channel_group(name, lag_id, mode))

    def write(self, label, fn):
        try:
            r = fn()
            good = ok(r)
            self.set_msg(f"{label}: {'OK' if good else 'FAILED'}", bad=not good)
            self.refresh_data()
        except SwitchError as e:
            self.set_msg(f"{label}: {e}", bad=True)

    def run(self):
        self.refresh_data()
        while True:
            self.draw()
            try:
                c = self.s.getch()
            except KeyboardInterrupt:
                break
            rows = self.rows()

            if self.view == "help":
                if c in (curses.KEY_DOWN, ord("j")):
                    self.help_scroll += 1
                elif c in (curses.KEY_UP, ord("k")):
                    self.help_scroll = max(0, self.help_scroll - 1)
                elif c == curses.KEY_NPAGE:
                    self.help_scroll += 15
                elif c == curses.KEY_PPAGE:
                    self.help_scroll = max(0, self.help_scroll - 15)
                elif c in (ord("q"), 27):
                    break
                elif c != -1:
                    self.view, self.help_scroll = "ports", 0
                    self.refresh_data()
                continue

            if c in (ord("q"), 27):
                break
            elif c in (curses.KEY_DOWN, ord("j")):
                self.sel = min(self.sel + 1, max(0, len(rows) - 1))
            elif c in (curses.KEY_UP, ord("k")):
                self.sel = max(self.sel - 1, 0)
            elif c in (ord("?"), curses.KEY_F1):
                self.view = "help"
            elif c == ord("i"):
                self.detail = not self.detail
            elif c == ord("r"):
                self.set_msg("")
                self.refresh_data(force=True)
            elif c in [ord(k) for _, k in VIEWS if k != "?"]:
                self.view = [n for n, k in VIEWS if k == chr(c)][0]
                self.sel = self.top = 0
                self.set_msg("")
                self.refresh_data()
            elif c == ord(" ") and self.view == "ports" and rows:
                p = rows[self.sel]
                up = p["adminState"] != "1"
                if up or self.may_shut(p["interfaceName"]):
                    self.write(f"{p['interfaceName']} admin "
                               f"{'up' if up else 'shut'}",
                               lambda: self.sw.set_port_admin(
                                   p["interfaceName"], up))
            elif c == ord("g") and self.view == "ports" and rows:
                self.bind_lag(rows[self.sel])
            elif c == ord(" ") and self.view == "poe" and rows:
                p = rows[self.sel]
                on = p["adminEnable"] != "1"
                self.write(f"PoE {p['interfaceName']} {'on' if on else 'off'}",
                           lambda: self.sw.set_poe(p["interfaceName"], on))
            elif c == ord("n") and self.view == "vlans":
                vid = self.prompt("new VLAN id (1-4094), ESC cancels:")
                if vid is None:
                    self.set_msg("cancelled")
                elif vid.isdigit() and 1 <= int(vid) <= 4094:
                    self.write(f"create VLAN {vid}",
                               lambda: self.sw.vlan(vid, True))
                elif vid:
                    self.set_msg(f"'{vid}' is not a valid VLAN id", bad=True)
            elif c == ord("d") and self.view == "vlans" and rows:
                vid = rows[self.sel]["VLANID"]
                if vid in ("1", "2363"):
                    self.set_msg(f"refusing to delete VLAN {vid} - system VLAN "
                                 f"(2363 carries this session)", bad=True)
                elif self.prompt(f"delete VLAN {vid}? type yes:") == "yes":
                    self.write(f"delete VLAN {vid}",
                               lambda: self.sw.vlan(vid, False))
            elif c == ord("w") and self.view == "config":
                try:
                    fs = save_config(self.sw)
                    self.set_msg("wrote " + ", ".join(os.path.basename(f) for f in fs))
                except Exception as e:
                    self.set_msg(str(e), bad=True)
            elif c == ord("u") and self.view == "config":
                self.set_msg("checking github ...")
                self.draw()
                try:
                    tag, newer, _ = check_update()
                    self.update_tag = tag if newer else None
                    self.set_msg(
                        f"{tag} is available - run 'encs-switch-tui --update' "
                        f"as root" if newer
                        else f"up to date: {VERSION} is the latest release")
                except UpdateError as e:
                    self.set_msg(str(e), bad=True)
            elif c == ord("a") and self.view == "config":
                if self.prompt("apply saved config to the switch? type yes:") == "yes":
                    try:
                        res = apply_config(self.sw)
                        self.set_msg("  ".join(f"{f}:{'OK' if g else 'FAIL'}"
                                               for f, g in res) or "nothing to apply",
                                     bad=any(not g for _, g in res))
                    except Exception as e:
                        self.set_msg(str(e), bad=True)

            if (time.time() - self.last_refresh > 10
                    and self.view in ("ports", "poe", "stats")):
                self.refresh_data()


# =================================================================== main
def cli_status(sw):
    try:
        sw.login()
        ports = sw.ports()
    except SwitchError as e:
        print(f"UNREACHABLE: {e}")
        return 1
    gi = [p for p in ports if p["interfaceName"].startswith("gi")]
    up = sum(1 for p in gi if p["linkState"] == "1")
    shut = sum(1 for p in gi if p["adminState"] == "2")
    print(f"switch {sw.ip}: OK - {len(gi)} front ports, {up} link up, "
          f"{shut} disabled")
    if shut:
        print("  WARNING: disabled ports will not pass traffic "
              "(run the TUI, select the port, press SPACE)")
    sw.logout()
    return 0


def main():
    sw = Switch()
    arg = sys.argv[1] if len(sys.argv) > 1 else ""

    if arg in ("-h", "--help"):
        print(__doc__)
        return
    if arg in ("--version", "-V"):
        print(f"encs-switch-tui {VERSION}")
        return
    if arg in ("--check-update", "--update"):
        try:
            if arg == "--check-update":
                tag, newer, _ = check_update()
                print(f"installed {VERSION}, latest release {tag}"
                      + ("  -- run 'encs-switch-tui --update'" if newer
                         else "  -- up to date"))
                return
            if do_update(force="--force" in sys.argv):
                print("done. Restart any running encs-switch-tui.")
        except UpdateError as e:
            sys.exit(f"ERROR: {e}")
        return
    if arg == "--status":
        sys.exit(cli_status(sw))
    if arg in ("--save", "--apply"):
        try:
            sw.login()
        except SwitchError as e:
            sys.exit(f"ERROR: {e}")
        if arg == "--save":
            for f in save_config(sw):
                print("wrote", f)
            sw.logout()
            return
        bad = False
        for f, good in apply_config(sw):
            print(f"{f}: {'OK' if good else 'FAILED'}")
            bad |= not good
        sw.logout()
        sys.exit(1 if bad else 0)

    try:
        sw.login()
    except SwitchError as e:
        sys.exit(
            f"ERROR: {e}\n\n"
            f"  This tool must run on the HYPERVISOR - the switch is reachable\n"
            f"  over VLAN 2363 on the X710 backplane, which the host owns.\n"
            f"  The bootstrap VM cannot reach it.\n\n"
            f"  Checks:\n"
            f"    ip -br addr show sw2363     -> expect 169.254.1.1/16\n"
            f"    ping -c2 {SW_IP}\n"
            f"    qm list                     -> is the bootstrap VM running?\n"
            f"  In the VM:  encs-switch-status\n")
    try:
        curses.wrapper(lambda scr: UI(scr, sw).run())
    finally:
        sw.logout()


if __name__ == "__main__":
    main()
