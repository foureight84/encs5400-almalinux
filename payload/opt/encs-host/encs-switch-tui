    def goto(self, view):
        self.view = view
        self.sel = self.top = 0
        self.set_msg("")
        self.refresh_data()

    def _menu_step(self, mrows, delta, start=None):
        """Move the menu selection, skipping group headings."""
        i = self.sel if start is None else start
        for _ in range(len(mrows)):
            i += delta
            if i < 0 or i >= len(mrows):
                break                     # ran off the end; stay put
            if mrows[i][0] == "V":
                return i
        return self.sel

    def _spec_key(self, c):
        """Run a spec view's action for this key. True if it handled it."""
        actions = self.spec().get("actions", {})
        key = "\n" if c in (curses.KEY_ENTER, 10, 13) else \
            (chr(c) if 32 <= c < 127 else None)
        if key is None or key not in actions:
            return False
        getattr(self, actions[key])()
        return True

    def run(self):
        self.refresh_data()
        while True:
            self.draw()
            try:
                c = self.s.getch()
            except KeyboardInterrupt:
                break
            rows = self.rows()

            if self.view == "help":
                if c in (curses.KEY_DOWN, ord("j")):
                    self.help_scroll += 1
                elif c in (curses.KEY_UP, ord("k")):
                    self.help_scroll = max(0, self.help_scroll - 1)
                elif c == curses.KEY_NPAGE:
                    self.help_scroll += 15
                elif c == curses.KEY_PPAGE:
                    self.help_scroll = max(0, self.help_scroll - 15)
                elif c in (ord("q"), 27):
                    break
                elif c != -1:
                    self.view, self.help_scroll = "ports", 0
                    self.refresh_data()
                continue

            if self.view == "menu":
                mrows = self.menu_rows()
                if c in (curses.KEY_DOWN, ord("j")):
                    self.sel = self._menu_step(mrows, 1)
                elif c in (curses.KEY_UP, ord("k")):
                    self.sel = self._menu_step(mrows, -1)
                elif c in (curses.KEY_ENTER, 10, 13):
                    if 0 <= self.sel < len(mrows) and mrows[self.sel][0] == "V":
                        self.goto(mrows[self.sel][1])
                elif c in (ord("q"), 27, 9):
                    self.goto("ports")
                continue

            if c == 27 and self.view in SPECS:
                # ESC goes back where you came from, rather than quitting
                # the whole tool. In the tabbed views ESC has always meant
                # quit and still does; but a view reached THROUGH the menu
                # reads as one level down, and losing the session because
                # you backed out of the ACL screen is a bad surprise.
                self.view = "menu"
                self.top = 0
                self.sel = self._menu_step(self.menu_rows(), 1, start=-1)
                self.set_msg("")
                continue
            if c in (ord("q"), 27):
                break
            elif c == 9:                                      # TAB
                self.view = "menu"
                self.set_msg("")
                # top is shared with the list views, so reset it or the
                # menu opens scrolled to wherever the last view was.
                self.top = 0
                # Land on the first real entry, not the group heading.
                self.sel = self._menu_step(self.menu_rows(), 1, start=-1)
                continue
            elif c in (curses.KEY_DOWN, ord("j")):
                self.sel = min(self.sel + 1, max(0, len(rows) - 1))
            elif c in (curses.KEY_UP, ord("k")):
                self.sel = max(self.sel - 1, 0)
            elif c in (ord("?"), curses.KEY_F1):
                self.view = "help"
            elif c == ord("i"):
                self.detail = not self.detail
            elif c == ord("r"):
                self.set_msg("")
                self.refresh_data(force=True)
            elif self.view in SPECS and self._spec_key(c):
                pass
            elif c in [ord(k) for _, k in VIEWS if k != "?"]:
                self.view = [n for n, k in VIEWS if k == chr(c)][0]
                self.sel = self.top = 0
                self.set_msg("")
                self.refresh_data()
            elif c == ord(" ") and self.view == "ports" and rows:
                p = rows[self.sel]
                up = p["adminState"] != "1"
                if up or self.may_shut(p["interfaceName"]):
                    self.write(f"{p['interfaceName']} admin "
                               f"{'up' if up else 'shut'}",
                               lambda: self.sw.set_port_admin(
                                   p["interfaceName"], up))
            elif c == ord("g") and self.view == "ports" and rows:
                self.bind_lag(rows[self.sel])
            elif c in (curses.KEY_ENTER, 10, 13) and self.view == "ports" \
                    and rows:
                self.act_port_settings()
            elif c == ord("z") and self.view in ("ports", "stats") and rows:
                self.act_clear_counters()
            elif c == ord("f") and self.view == "mac":
                self.act_flush_macs()
            elif c in (curses.KEY_ENTER, 10, 13) and self.view == "poe" \
                    and rows:
                self.act_poe_limit()
            elif c in (curses.KEY_ENTER, 10, 13) and self.view == "vlans":
                self.act_vlan_ports()
            elif c == ord("N") and self.view == "vlans" and rows:
                self.act_vlan_rename()
            elif c == ord(" ") and self.view == "poe" and rows:
                p = rows[self.sel]
                on = p["adminEnable"] != "1"
                self.write(f"PoE {p['interfaceName']} {'on' if on else 'off'}",
                           lambda: self.sw.set_poe(p["interfaceName"], on))
            elif c == ord("n") and self.view == "vlans":
                vid = self.prompt("new VLAN id (1-4094), ESC cancels:")
                if vid is None:
                    self.set_msg("cancelled")
                elif vid.isdigit() and 1 <= int(vid) <= 4094:
                    # The name is optional: ENTER on an empty prompt creates
                    # the VLAN unnamed, which is what this did before.
                    name = self.prompt("name (optional), ESC cancels:",
                                       maxlen=32)
                    if name is None:
                        self.set_msg("cancelled")
                    else:
                        self.write(f"create VLAN {vid}",
                                   lambda: self.sw.vlan(vid, True,
                                                        name or None))
                elif vid:
                    self.set_msg(f"'{vid}' is not a valid VLAN id", bad=True)
            elif c == ord("d") and self.view == "vlans" and rows:
                vid = rows[self.sel]["VLANID"]
                if vid in ("1", "2363"):
                    self.set_msg(f"refusing to delete VLAN {vid} - system VLAN "
                                 f"(2363 carries this session)", bad=True)
                elif self.prompt(f"delete VLAN {vid}? type yes:") == "yes":
                    self.write(f"delete VLAN {vid}",
                               lambda: self.sw.vlan(vid, False))
            elif c == ord("w") and self.view == "config":
                # A full save is ~30 sequential GETs over a link-local
                # HTTPS session and blocks the UI for a noticeable moment.
                # Say so first, or it reads as a hang.
                self.set_msg("saving - reading every table, this takes a "
                             "few seconds ...")
                self.draw()
                try:
                    fs = save_config(self.sw)
                    self.set_msg(f"wrote {len(fs)} files: " + ", ".join(
                        os.path.basename(f) for f in fs))
                except Exception as e:
                    self.set_msg(str(e), bad=True)
            elif c == ord("u") and self.view == "config":
                self.set_msg("checking github ...")
                self.draw()
                try:
                    tag, newer, _ = check_update()
                    self.update_tag = tag if newer else None
                    self.set_msg(
                        f"{tag} is available - run 'encs-switch-tui --update' "
                        f"as root" if newer
                        else f"up to date: {VERSION} is the latest release")
                except UpdateError as e:
                    self.set_msg(str(e), bad=True)
            elif c == ord("a") and self.view == "config":
                if self.prompt("apply saved config to the switch? type yes:") == "yes":
                    try:
                        res = apply_config(self.sw)
                        self.set_msg("  ".join(f"{f}:{'OK' if g else 'FAIL (' + why + ')'}"
                                               for f, g, why in res) or "nothing to apply",
                                     bad=any(not g for _, g, _w in res))
                    except Exception as e:
                        self.set_msg(str(e), bad=True)

            # STP joins the auto-refreshing views: port role and state change
            # on their own during convergence, and a static screen through
            # 30s of listening/learning looks like a hang.
            if (time.time() - self.last_refresh > 10
                    and self.view in ("ports", "poe", "stats", "stp")):
                self.refresh_data()


# ============================================================== view specs
# Each entry describes a view completely: where its rows come from, how they
# render, what the keys do. Adding a table is an entry here plus a client
# method, not another pair of draw/dispatch branches.
def raw(key, default="-"):
    return lambda r: (r.get(key) or default)


def enum_col(table, key, default="-"):
    """Render an enum field through its lookup, falling back to the raw
    value - a firmware that reports a code we have never seen should show
    the code, not a blank."""
    def fn(r):
        v = (r.get(key) or "").strip()
        return table.get(v, v or default)
    return fn


def yesno(key):
    return enum_col(ENABLED, key)


def merge_by_port(*tables):
    """Join per-port tables into one row per interface.

    Order is taken from the first table that has the port, so the result
    lists ports in the switch's own order rather than a dict's.
    """
    out, order = {}, []
    for t in tables:
        for r in t:
            n = r.get("interfaceName")
            if not n:
                continue
            if n not in out:
                out[n], _ = {}, order.append(n)
            out[n].update({k: v for k, v in r.items() if v != ""})
            out[n]["interfaceName"] = n
    return [out[n] for n in order]


def rate_col(kind):
    """A storm-control rate as value+unit, or "off" when the value is 0."""
    def fn(r):
        v = (r.get(f"{kind}RateValue") or "").strip()
        if v in ("", "0"):
            return "off"
        return f"{v}{STORM_UNIT.get((r.get(f'{kind}UnitType') or '').strip(), '')}"
    return fn


# ---- fetches ------------------------------------------------------------
# --------------------------------------------------------------- vnet view
# The host half of "which jack does this VM come out of" lives in
# encs-switch-vnet, and stays there: /etc/network/interfaces is a different
# kind of thing from the switch API, with a different way to be wrong. This
# view imports that tool and calls it, rather than growing a second copy of
# a bridge writer inside a curses app.
_VNET = [None]


class _Globals:
    """Attribute access over another module's globals, without copying it."""

    def __init__(self, g):
        self.__dict__ = g


def load_vnet():
    """The encs-switch-vnet module, or None if it is not installed.

    An older bundle, or a checkout without it, must degrade to a view that
    explains itself rather than a traceback. Cached because importing it
    walks the filesystem.
    """
    if _VNET[0] is not None:
        return _VNET[0] or None
    import importlib.util
    from importlib.machinery import SourceFileLoader
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in ("/usr/local/sbin/encs-switch-vnet",
                 os.path.join(here, "encs-switch-vnet")):
        if not os.path.exists(cand):
            continue
        try:
            loader = SourceFileLoader("encs_switch_vnet", cand)
            spec = importlib.util.spec_from_loader(loader.name, loader)
            mod = importlib.util.module_from_spec(spec)
            # It imports this module back. Hand it the instance that is
            # already running: a second copy would define a second
            # SwitchError, and its except clauses would stop catching the
            # exceptions raised by the Switch object it is handed.
            #
            # Not via sys.modules - a module loaded by SourceFileLoader is
            # not registered there, which is how both this file and the
            # test harness load it. _Globals wraps this module's globals so
            # attribute lookups reach the live objects with no copying.
            mod.__dict__["_TUI_MODULE"] = _Globals(globals())
            loader.exec_module(mod)
            _VNET[0] = mod
            return mod
        except Exception:
            break
    _VNET[0] = False
    return None


def fetch_vnet(sw):
    """One row per VLAN: which jacks it reaches, and how a VM attaches."""
    vn = load_vnet()
    ifv = {r["interfaceName"]: r for r in (_try(sw.vlan_interfaces, []) or [])}
    ports = {p["interfaceName"]: p for p in (_try(sw.ports, []) or [])}
    host = vn.host_status() if vn else {}
    users = host.get("users", {})
    rows = []
    for vl in (_try(sw.vlans, []) or []):
        vid = vl["VLANID"]
        jacks = []
        for i in range(8):
            name = f"gi{i}"
            if name not in ifv or vn is None:
                continue
            if vn.access_vlan_of(ifv[name]) != vid:
                continue
            mark = "*" if ports.get(name, {}).get("linkState") == "1" else (
                "x" if ports.get(name, {}).get("adminState") == "2" else "")
            jacks.append(panel_label(name).replace("GE", "") + mark)
        if vid == MGMT_VLAN:
            attach, who = "-- management --", ""
        else:
            br = host.get("bridge", "swbr0")
            attach = br if vid == "1" else f"{br},tag={vid}"
            who = ", ".join(users.get(None if vid == "1" else vid, []))
        rows.append({"VLANID": vid, "VLANName": vl.get("VLANName") or "",
                     "jacks": " ".join(jacks), "attach": attach, "vms": who})
    # A VM tagged into a VLAN the switch does not have looks like a broken
    # NIC from inside the guest, and like nothing at all from here - so it
    # gets a row of its own rather than no mention.
    known = {r["VLANID"] for r in rows}
    for tag, who in sorted((k, v) for k, v in users.items() if k):
        if tag not in known:
            rows.append({"VLANID": tag, "VLANName": "NO SUCH VLAN",
                         "jacks": "-", "attach": f"{host.get('bridge')},"
                                                 f"tag={tag}",
                         "vms": ", ".join(who)})
    host["te2"] = ifv.get("te2", {})
    host["missing"] = vn is None
    if vn is not None:
        host["startup_plan"] = vn.startup_plan(
            vn.vm_inventory(), vn.our_bridges(), vn.bootstrap_vmid(), 90)
    return {"rows": rows, "extra": host}


def vnet_summary(x):
    """The host half, above the table: does the bridge exist, and is it sane."""
    if x.get("missing"):
        return ["encs-switch-vnet is not installed - this view can only look",
                "on. Copy the host bundle again and re-run install.sh."]
    br, bp = x.get("bridge", "swbr0"), x.get("backplane")
    if not x.get("bridge_up"):
        return [f"{br}: not created. VMs land on vmbr0 - the MGMT CPU jack -",
                f"and share the interface you manage this host over.",
                f"n creates it (the Proxmox equivalent of NFVIS's lan-br)."]
    members = ", ".join(x.get("members") or []) or "none"
    ok = bp and bp in (x.get("members") or [])
    line = f"{br}: up, ports {members}" + ("" if ok else
                                           f"  <- expected {bp}")
    mgmt = f"{x.get('mgmt_if')}: " + ("up" if x.get("mgmt_up") else "MISSING")
    named = ", ".join(f"{n} (vlan {v})" for n, v in x.get("vnets") or [])
    out = [line, f"{mgmt}   {'named bridges: ' + named if named else ''}"]
    # A guest that starts before the ASIC finds a bridge that forwards
    # nothing for the first minute or so, and nothing on screen would
    # otherwise connect that to its failed DHCP.
    if x.get("startup_plan"):
        out.append(f"{len(x['startup_plan'])} VM(s) start before the switch "
                   f"is up - run: encs-switch-vnet startup")
    return out


