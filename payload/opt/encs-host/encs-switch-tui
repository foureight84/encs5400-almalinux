def acl_detail_for(ui):
    def fn(r):
        name = r.get("ACLName", "")
        x = ui.extra()
        rules = [a for a in x.get("aces", []) if a.get("ACLName") == name]
        binds = [b for b in x.get("bindings", [])
                 if name in (b.get("ACLIPv4MACName"),
                             b.get("ACLIPv4MACNameOut"))]
        out = [f"{name}  ({ACL_TYPE.get(r.get('ACLType', ''), '?')} ACL)"]
        if rules:
            for a in sorted(rules, key=lambda a: a.get("rulePriority", "")):
                out.append(f"  {a.get('rulePriority', '?'):>5}  "
                           f"{ACL_ACTION.get(a.get('ruleAction', ''), '?'):7}"
                           f"src {a.get('sourceMACAddress', 'any')}  "
                           f"dst {a.get('destMACAddress', 'any')}")
        else:
            out.append("  no rules - an empty ACL matches nothing. ENTER adds one.")
        out.append("  bound to: " + (", ".join(
            b.get("interfaceName", "?") for b in binds) or "nothing (b binds it)"))
        return out
    return fn


def mirror_detail_for(ui):
    def fn(r):
        s = r.get("sessionId", "")
        src = [x for x in ui.extra().get("sources", [])
               if x.get("sessionId") == s]
        out = [f"session {s} -> {span_ifname(r.get('ifIndex', ''))}"
               f"  ({SPAN_PORT_TYPE.get(r.get('portType', ''), '?')})"]
        for x in src:
            out.append(f"  mirroring {span_ifname(x.get('sourceIdx', ''))}"
                       f"  {SPAN_DIR.get(x.get('sourceDirection', ''), '?')}")
        if not src:
            out.append("  no sources yet - a destination with nothing "
                       "mirrored into it copies nothing. Press a.")
        return out
    return fn


def pvlan_detail_for(ui):
    def fn(r):
        vid = r.get("VLANID", "")
        x = ui.extra()
        out = [f"VLAN {vid}  "
               f"{PVLAN_TYPE.get(r.get('privateVLANType', ''), '?')}"]
        for a in x.get("assoc", []):
            if a.get("primaryVLANID") == vid:
                out.append(f"  secondaries: {a.get('communityVLANsList', '-')}")
